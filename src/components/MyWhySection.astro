---
import ProfessionalInterestsLoop from "./ProfessionalInterestsLoop.jsx";
---

<section id="my-why" class="my-why" aria-labelledby="my-why-title" data-my-why>
  <div class="my-why__interests">
    <ProfessionalInterestsLoop client:load />
  </div>

  <div class="my-why__manifesto" data-my-why-manifesto>
    <header class="my-why__label" data-my-why-label>
      <h2 id="my-why-title" class="my-why__title">My Why</h2>
      <span class="my-why__line" aria-hidden="true" data-my-why-line></span>
      <span class="my-why__mark" aria-hidden="true">✳</span>
    </header>

    <div
      class="my-why__statement"
      data-my-why-statement
      aria-label="Products shape people’s life experiences. I want to build products that people love by placing them at the center."
    >
      <p class="my-why__sentence my-why__sentence--premise" data-my-why-sentence>
        Products shape people’s life experiences.
      </p>
      <p class="my-why__sentence my-why__sentence--intent" data-my-why-sentence>
        I want to build products that people love by placing them at the center.
      </p>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.querySelectorAll("[data-my-why]").forEach((section) => {
    if (!(section instanceof HTMLElement) || section.dataset.whyReady === "true") return;

    const manifesto = section.querySelector("[data-my-why-manifesto]");
    const label = section.querySelector("[data-my-why-label]");
    const line = section.querySelector("[data-my-why-line]");
    const statement = section.querySelector("[data-my-why-statement]");
    const sentences = Array.from(section.querySelectorAll("[data-my-why-sentence]"));
    if (
      !(manifesto instanceof HTMLElement) ||
      !(label instanceof HTMLElement) ||
      !(line instanceof HTMLElement) ||
      !(statement instanceof HTMLElement) ||
      !sentences.every((sentence) => sentence instanceof HTMLElement)
    ) return;

    section.dataset.whyReady = "true";
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
    const animationMedia = gsap.matchMedia();
    let pointerFrame = 0;

    animationMedia.add(
      {
        desktop: "(min-width: 801px)",
        compact: "(max-width: 800px)",
        reduceMotion: "(prefers-reduced-motion: reduce)",
      },
      (context) => {
        const { compact, reduceMotion } = context.conditions;

        if (reduceMotion) {
          gsap.set([label, line, ...sentences], {
            autoAlpha: 1,
            x: 0,
            y: 0,
            scaleX: 1,
            clipPath: "inset(0% 0% 0% 0%)",
          });
          return;
        }

        // Stage the entire manifesto before ScrollTrigger measures it. Using
        // explicit starting values avoids the browser briefly painting the
        // completed copy (and keeps direct/hash loads deterministic).
        gsap.set(label, {
          autoAlpha: 0,
          scale: 0.985,
          transformOrigin: "left bottom",
        });
        gsap.set(line, {
          scaleX: 0,
          transformOrigin: "left center",
        });
        gsap.set(sentences[0], {
          autoAlpha: 0,
          x: compact ? -36 : -84,
          clipPath: "inset(0% 0% 100% 0%)",
        });
        gsap.set(sentences[1], {
          autoAlpha: 0,
          x: compact ? 36 : 84,
          clipPath: "inset(0% 0% 100% 0%)",
        });

        const labelReveal = gsap.timeline({
          scrollTrigger: {
            trigger: manifesto,
            start: compact ? "top 88%" : "top 80%",
            end: compact ? "top 68%" : "top 60%",
            scrub: compact ? 0.12 : 0.18,
            invalidateOnRefresh: true,
          },
        });

        labelReveal
          .to(label, {
            autoAlpha: 1,
            scale: 1,
            duration: 0.6,
            ease: "power1.out",
          })
          .to(
            line,
            {
              scaleX: 1,
              duration: 0.7,
              ease: "none",
            },
            0.12,
          );

        const reveal = gsap.timeline({
          scrollTrigger: {
            trigger: manifesto,
            start: compact ? "top 80%" : "top 70%",
            end: "+=18%",
            scrub: compact ? 0.1 : 0.12,
            invalidateOnRefresh: true,
          },
        });

        reveal
          .to(
            sentences[0],
            {
              autoAlpha: 1,
              x: 0,
              clipPath: "inset(0% 0% 0% 0%)",
              duration: 0.4,
              ease: "none",
            },
            0,
          )
          .to(
            sentences[1],
            {
              autoAlpha: 1,
              x: 0,
              clipPath: "inset(0% 0% 0% 0%)",
              duration: 0.4,
              ease: "none",
            },
            0.14,
          );
      },
      section,
    );

    const updateSpotlight = (event) => {
      if (!finePointer.matches) return;
      window.cancelAnimationFrame(pointerFrame);
      pointerFrame = window.requestAnimationFrame(() => {
        const sectionBounds = section.getBoundingClientRect();
        section.style.setProperty("--section-spot-x", `${event.clientX - sectionBounds.left}px`);
        section.style.setProperty("--section-spot-y", `${event.clientY - sectionBounds.top}px`);

        sentences.forEach((sentence) => {
          if (!(sentence instanceof HTMLElement)) return;
          const bounds = sentence.getBoundingClientRect();
          sentence.style.setProperty("--spot-x", `${event.clientX - bounds.left}px`);
          sentence.style.setProperty("--spot-y", `${event.clientY - bounds.top}px`);
        });
        statement.classList.add("has-pointer");
      });
    };

    const resetSpotlight = () => statement.classList.remove("has-pointer");

    manifesto.addEventListener("pointermove", updateSpotlight, { passive: true });
    manifesto.addEventListener("pointerleave", resetSpotlight, { passive: true });

    const cleanup = () => {
      animationMedia.revert();
      window.cancelAnimationFrame(pointerFrame);
      manifesto.removeEventListener("pointermove", updateSpotlight);
      manifesto.removeEventListener("pointerleave", resetSpotlight);
    };

    window.addEventListener("pagehide", cleanup, { once: true });
    document.addEventListener("astro:before-swap", cleanup, { once: true });

    const refresh = () => window.requestAnimationFrame(() => ScrollTrigger.refresh());
    if (document.fonts?.ready) document.fonts.ready.then(refresh);
    else refresh();
  });
</script>

<style>
  .my-why {
    --my-why-space: clamp(96px, 10vw, 156px);
    --my-why-handoff: clamp(56px, 6vw, 92px);
    --section-spot-x: 50%;
    --section-spot-y: 52%;
    position: relative;
    padding: var(--my-why-space) var(--page-gutter) clamp(32px, 4vw, 56px);
    background-color: var(--site-dark, #0d0d0d);
    background-image:
      radial-gradient(circle 360px at var(--section-spot-x) var(--section-spot-y), rgba(255, 255, 255, 0.028), transparent 76%),
      radial-gradient(circle at 1.2px 1.2px, rgba(255, 255, 255, 0.22) 1.2px, transparent 1.45px);
    background-position: 0 0, 12px 12px;
    background-size: auto, 24px 24px;
    background-attachment: scroll, fixed;
    color: #f7f5f1;
    overflow: hidden;
    scroll-margin-top: 88px;
  }

  .my-why__interests {
    position: relative;
    z-index: 1;
    width: calc(100% + (var(--page-gutter) * 2));
    margin: calc(var(--my-why-space) * -1) calc(var(--page-gutter) * -1) var(--my-why-handoff);
    border-block: 1px solid rgba(13, 13, 13, 0.14);
    background: #f7f5f1;
    color: #0d0d0d;
    overflow: hidden;
  }

  :global(body[data-theme="light"]) .my-why__interests {
    border-color: rgba(62, 43, 35, 0.16);
    background: #eee2dc;
    color: #211b19;
  }

  :global(body[data-theme="light"]) .my-why__interests :global(.professional-loop),
  :global(body[data-theme="light"]) .my-why__interests :global(.professional-loop__term) {
    color: #211b19;
  }

  :global(body[data-theme="light"]) .my-why__interests :global(.professional-loop__separator) {
    color: #c94b2c;
  }

  .my-why__manifesto {
    position: relative;
    z-index: 1;
    width: min(var(--content-width), 100%);
    margin-inline: auto;
  }

  .my-why__label {
    display: grid;
    grid-template-columns: auto minmax(72px, 1fr) auto;
    gap: clamp(18px, 2.8vw, 44px);
    align-items: center;
    margin-bottom: clamp(30px, 3.8vw, 52px);
    overflow: visible;
  }

  .my-why__title {
    margin: 0;
    padding: 0 0 0.1em;
    color: #f7f5f1;
    font-size: clamp(3.2rem, 5.8vw, 6.2rem);
    font-weight: 700;
    letter-spacing: -0.065em;
    line-height: 0.98;
    overflow: visible;
  }

  .my-why__line {
    display: block;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, rgba(255, 90, 31, 0.95), rgba(209, 42, 114, 0.82) 58%, rgba(255, 255, 255, 0.12));
  }

  .my-why__mark {
    color: #ff5a1f;
    font-size: clamp(1.35rem, 2.2vw, 2.2rem);
    line-height: 1;
  }

  .my-why__statement {
    display: grid;
    gap: clamp(28px, 3vw, 46px);
    width: 100%;
  }

  .my-why__sentence {
    --spot-x: 50%;
    --spot-y: 50%;
    width: min(100%, 18ch);
    margin: 0;
    background: radial-gradient(
      circle clamp(180px, 19vw, 300px) at var(--spot-x) var(--spot-y),
      #ffffff 0%,
      #ffffff 25%,
      rgba(247, 245, 241, 0.94) 42%,
      rgba(247, 245, 241, 0.24) 76%
    );
    background-clip: text;
    color: rgba(247, 245, 241, 0.24);
    font-size: clamp(2.8rem, 5.35vw, 6.2rem);
    font-weight: 600;
    letter-spacing: -0.064em;
    line-height: 0.98;
    text-wrap: balance;
    will-change: transform, opacity, clip-path;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .my-why__sentence--premise {
    max-width: 14ch;
  }

  .my-why__sentence--intent {
    justify-self: end;
    max-width: 19ch;
    padding-left: 0;
    text-align: right;
  }

  @media (hover: hover) and (pointer: fine) {
    .my-why__statement:not(.has-pointer) .my-why__sentence {
      background: none;
      -webkit-text-fill-color: rgba(247, 245, 241, 0.24);
    }
  }

  @media (max-width: 800px) {
    .my-why {
      --my-why-space: clamp(82px, 22vw, 120px);
      --my-why-handoff: clamp(36px, 10vw, 56px);
      padding-block: var(--my-why-space) clamp(36px, 11vw, 52px);
      background-image: radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.2) 1px, transparent 1.2px);
      background-position: 12px 12px;
      background-size: 24px 24px;
      background-attachment: fixed;
    }

    .my-why__label {
      grid-template-columns: 1fr auto;
      gap: 22px;
      margin-bottom: clamp(38px, 11vw, 58px);
    }

    .my-why__title {
      font-size: clamp(3.4rem, 15vw, 5.5rem);
    }

    .my-why__line {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .my-why__mark {
      justify-self: end;
    }

    .my-why__statement {
      gap: clamp(34px, 10vw, 52px);
    }

    .my-why__sentence {
      max-width: none;
      background: none;
      color: rgba(247, 245, 241, 0.94);
      font-size: clamp(2.5rem, 11vw, 4.2rem);
      line-height: 1.01;
      text-wrap: pretty;
      -webkit-text-fill-color: rgba(247, 245, 241, 0.94);
    }

    .my-why__sentence--intent {
      justify-self: end;
      padding-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .my-why__sentence {
      will-change: auto;
    }
  }
</style>
