      opacity 300ms ease,
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .yin-yang-option::before {
    position: absolute;
    z-index: 0;
    inset: 7px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    content: "";
    opacity: 0.24;
    transform: translateY(1px) scale(0.97);
    transition:
      opacity 260ms ease,
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 360ms ease;
    pointer-events: none;
