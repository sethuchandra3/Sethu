  .yin-yang-option {
    position: relative;
    z-index: 4;
    isolation: isolate;
    min-height: 82px;
    border: 0;
    border-radius: 999px;
    padding: 16px clamp(22px, 2.6vw, 34px);
    background: transparent;
    font-family: Arial, Helvetica, sans-serif;
