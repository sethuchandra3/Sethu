---
import "../styles/global.css";
import ConnectSection from "../components/ConnectSection.jsx";
import ProjectsSection from "../components/ProjectsSection.jsx";
import DomeGallery from "../components/DomeGallery.jsx";
import DecryptedText from "../components/DecryptedText.jsx";
import ExperienceSection from "../components/ExperienceSection.jsx";
import MyWhySection from "../components/MyWhySection.astro";
import CoolThingsSection from "../components/CoolThingsSection.jsx";
import AboutSection from "../components/AboutSection.jsx";
import HeaderDock from "../components/HeaderDock.jsx";
import BlurText from "../components/BlurText.jsx";
import FluidGlassCursor from "../components/FluidGlassCursor.jsx";
import Analytics from "@vercel/analytics/astro";
import geistUrl from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import robotoFlexUrl from "@fontsource-variable/roboto-flex/files/roboto-flex-latin-full-normal.woff2?url";

const latestEvents = [
  {
    title: "Building growth engines at Mesh",
    titlePrefix: "Building growth engines at ",
    linkText: "Mesh",
    linkKey: "mesh",
    companyUrl: "https://www.usemesh.com/",
  },
  {
    title: "Investing in the future at Bouken Capital",
    titlePrefix: "Investing in the future at ",
    linkText: "Bouken Capital",
    linkKey: "bouken",
    companyUrl: "https://www.boukencapital.com/",
  },
  {
    title: "Creating community at Lehigh Product Society",
    titlePrefix: "Creating community at ",
    linkText: "Lehigh Product Society",
    linkKey: "lehigh-product-society",
    companyUrl: "https://lehighproductsociety.org/",
  },
];

// Temporary launch flag: switch to false if My World needs to be hidden again.
const SHOW_MY_WORLD = true;

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (() => {
        try {
          const stored = window.localStorage.getItem("sethu-theme");
          // Light is the default regardless of the visitor's OS setting; only an
          // explicit choice from the header toggle can load the site in dark.
          const theme = stored === "dark" ? "dark" : "light";
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = "light";
        }
        // Hold the hero lockup back until the intro script owns it, so the
        // static markup never flashes before the typewriter starts.
        document.documentElement.classList.add("intro-pending");
        window.setTimeout(() => document.documentElement.classList.remove("intro-pending"), 2500);
      })();
    </script>
    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={robotoFlexUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Sethu Chandra is a creative engineer turning ambitious ideas into thoughtful products, meaningful communities, and unforgettable stories."
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Sethu Chandra" />
    <meta property="og:description" content="Creative engineer building thoughtful products, meaningful communities, and unforgettable stories." />
    <meta property="og:image" content="/assets/sethu-chandra-headshot.jpeg" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>Sethu Chandra</title>
    <Analytics />
  </head>
  <body>
    <FluidGlassCursor client:load />
    <HeaderDock client:load />
    <main>
      <section id="top" class="opening-stage" aria-labelledby="intro-title">
        <div class="opening-pin">
          <div class="name-lockup" id="intro-title">
            <p class="typed-line glitch-line" data-text="Hi! I'm,">Hi! I'm,</p>
            <h1 class="typed-line name-line" data-text="Sethu Chandra">Sethu Chandra</h1>
            <p class="identity-line" aria-label="I'm a builder, storyteller, learner">
              <span class="identity-prefix">I'm a</span>
              <span class="identity-word" aria-hidden="true">
                <span class="identity-word-typed">builder</span>
                <span class="text-type__cursor identity-word__cursor">|</span>
              </span>
            </p>
            <span class="scroll-note">scroll</span>
          </div>

          <span class="hello-mark" aria-hidden="true">
            <picture>
              <source media="(max-width: 760px)" srcset="/assets/hello-transparent-mobile.gif" />
              <img src="/assets/hello-transparent.gif" alt="" width="768" height="1152" loading="eager" fetchpriority="low" />
            </picture>
          </span>

          <div class="latest-content">
            <h2 id="latest-title">
              <BlurText
                as="span"
                text="As of lately..."
                delay={150}
                animateBy="words"
                direction="top"
                stepDuration={0.42}
                threshold={0.1}
                triggerEvent="latest-title-visibility"
                className="latest-title-blur"
                client:load
              />
            </h2>
            <div class="latest-deck" aria-label="Recent updates">
              {
                latestEvents.map((event, index) => (
                  <article
                    class={`deck-card${index === 0 ? " deck-card--mesh" : ""}`}
                    style={`--card-index: ${index}; --card-count: ${latestEvents.length}`}
                  >
                    <div class="deck-card-content">
                      <div class="deck-card-heading">
                        <h3>
                          {
                            event.companyUrl ? (
                              <>
                                {event.titlePrefix}
                                <a
                                  class={`company-link company-link--${event.linkKey}`}
                                  href={event.companyUrl}
                                  target="_blank"
                                  rel="noreferrer"
                                >
                                  {event.linkText}
                                  {event.linkKey === "mesh" && (
                                    <img src="/assets/mesh-mark-blue.png" alt="" width="173" height="173" aria-hidden="true" />
                                  )}
                                </a>
                                {event.titleSuffix}
                              </>
                            ) : (
                              event.title
                            )
                          }
                        </h3>
                      </div>
                    </div>
                    <div class="deck-card-peek" aria-hidden="true">
                      <h3>{event.title}</h3>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <AboutSection client:visible={{ rootMargin: "600px" }} />

      <ExperienceSection client:load />

      <MyWhySection />

      <ProjectsSection client:visible={{ rootMargin: "1800px" }} />

      <CoolThingsSection client:load />

      {
        SHOW_MY_WORLD && (
          <section class="world-section" aria-labelledby="world-title">
            <div class="world-heading">
              <h2 id="world-title">
                <DecryptedText
                  client:visible
                  text="My World"
                  speed={58}
                  sequential={true}
                  revealDirection="start"
                  characters="ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!?@#$%"
                  animateOn="view"
                  parentClassName="world-decrypted-text"
                  className="world-decrypted__revealed"
                  encryptedClassName="world-decrypted__encrypted"
                />
              </h2>
              <p class="world-subtitle">
                <DecryptedText
                  client:visible
                  text="Places I’ve travelled to and called home. Drag to explore."
                  speed={30}
                  sequential={true}
                  revealDirection="start"
                  characters="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!?@#$%"
                  animateOn="view"
                  parentClassName="world-subtitle-decrypted"
                  className="world-decrypted__revealed"
                  encryptedClassName="world-decrypted__encrypted"
                />
              </p>
            </div>
            <div class="dome-gallery-shell">
              <DomeGallery
                client:only="react"
                fit={0.65}
                minRadius={520}
                maxRadius={1080}
                maxVerticalRotationDeg={8}
                segments={36}
                grayscale={false}
                imageBorderRadius="16px"
                openedImageBorderRadius="22px"
                overlayBlurColor="#0d0d0d"
                autoSpinSpeed={1.1}
                imageFilter="saturate(0.9) contrast(1.06) brightness(0.82)"
              />
            </div>
            <aside class="travel-bucket-list" aria-labelledby="travel-bucket-list-title">
              <h3 id="travel-bucket-list-title">Places I want to go next</h3>
              <ul>
                <li>Spain</li>
                <li>Amsterdam</li>
                <li>Yakutsk, Russia</li>
                <li>Japan</li>
                <li>Iceland</li>
              </ul>
            </aside>
          </section>
        )
      }

      <ConnectSection client:load />
    </main>

    <script>
      import Lenis from "lenis";
      import "lenis/dist/lenis.css";
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      import { TextPlugin } from "gsap/TextPlugin";

      gsap.registerPlugin(ScrollTrigger, TextPlugin);

      let inertialScroll = null;
      const smoothScrollMedia = window.matchMedia(
        "(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)",
      );
      const runInertialFrame = (time) => inertialScroll?.raf(time * 1000);

      const destroyInertialScroll = () => {
        gsap.ticker.remove(runInertialFrame);
        inertialScroll?.destroy();
        inertialScroll = null;
      };

      const syncInertialScroll = () => {
        destroyInertialScroll();
        if (!smoothScrollMedia.matches) return;

        inertialScroll = new Lenis({
          duration: 1.15,
          easing: (progress) => 1 - Math.pow(1 - progress, 4),
          smoothWheel: true,
          wheelMultiplier: 0.9,
          syncTouch: false,
          touchMultiplier: 1,
          overscroll: false,
          autoRaf: false,
          anchors: {
            offset: -88,
            duration: 0.95,
          },
        });

        inertialScroll.on("scroll", ScrollTrigger.update);
        gsap.ticker.add(runInertialFrame);
        gsap.ticker.lagSmoothing(0);
        requestAnimationFrame(() => {
          inertialScroll?.resize();
          ScrollTrigger.refresh();
        });
      };

      // Preserve the browser's native back/forward and reload position. Hash
      // navigation is stabilized below after fonts and pinned sections settle.
      window.history.scrollRestoration = window.location.hash ? "manual" : "auto";

      const reloadScrollKey = "sethu-reload-scroll-y";
      const navigationEntry = performance.getEntriesByType("navigation")[0];
      const isPageReload = navigationEntry?.type === "reload";
      let reloadScrollState = null;
      if (isPageReload && !window.location.hash) {
        try {
          reloadScrollState = JSON.parse(window.sessionStorage.getItem(reloadScrollKey) || "null");
        } catch {
          reloadScrollState = null;
        }
      }
      window.addEventListener("pagehide", () => {
        try {
          const sections = [...document.querySelectorAll("main > section")];
          const viewportMiddle = window.innerHeight / 2;
          const sectionIndex = sections.findIndex((section) => {
            const bounds = section.getBoundingClientRect();
            return bounds.top <= viewportMiddle && bounds.bottom >= viewportMiddle;
          });
          const sectionBounds = sectionIndex >= 0 ? sections[sectionIndex].getBoundingClientRect() : null;
          const sectionProgress = sectionBounds?.height
            ? (viewportMiddle - sectionBounds.top) / sectionBounds.height
            : 0;
          window.sessionStorage.setItem(reloadScrollKey, JSON.stringify({
            y: window.scrollY,
            sectionIndex,
            sectionProgress,
          }));
        } catch {
          // Native restoration remains the fallback when storage is unavailable.
        }
      }, { once: true });

      syncInertialScroll();
      smoothScrollMedia.addEventListener("change", syncInertialScroll);
      window.addEventListener("pagehide", destroyInertialScroll, { once: true });

      const initialTheme = document.documentElement.dataset.theme || "light";
      document.documentElement.dataset.theme = initialTheme;
      document.body.dataset.theme = initialTheme;

      const typeInto = (element, delay = 0, instant = false) => {
        if (!element) return Promise.resolve();
        element._typewriterCleanup?.();

        const text = element.dataset.text ?? "";
        const shouldMakeInteractive = element.classList.contains("name-line");
        element.textContent = "";
        element.classList.add("text-type");

        const content = document.createElement("span");
        content.className = "text-type__content";
        element.appendChild(content);

        const appendChar = (char) => {
          const span = document.createElement("span");
          span.textContent = char === " " ? "\u00A0" : char;
          if (shouldMakeInteractive && char !== " ") {
            span.className = "name-letter";
            span.dataset.letter = char;
          }
          content.appendChild(span);
        };

        if (instant) {
          [...text].forEach(appendChar);
          return Promise.resolve();
        }

        const cursor = document.createElement("span");
        cursor.className = "text-type__cursor";
        cursor.textContent = "|";
        element.appendChild(cursor);

        const timeouts = [];
        const cursorTween = gsap.to(cursor, {
          opacity: 0,
          duration: 0.5,
          repeat: -1,
          yoyo: true,
          ease: "power2.inOut",
        });

        element._typewriterCleanup = () => {
          timeouts.forEach((timeout) => clearTimeout(timeout));
          cursorTween.kill();
          cursor.remove();
        };

        return new Promise((resolve) => {
          let index = 0;

          const typeNext = () => {
            if (index >= text.length) {
              gsap.to(cursor, {
                autoAlpha: 0,
                duration: 0.22,
                delay: 0.12,
                onComplete: () => {
                  element._typewriterCleanup?.();
                  element._typewriterCleanup = null;
                  resolve();
                },
              });
              return;
            }

            appendChar(text[index]);
            index += 1;
            const speed = 48 + Math.random() * 42;
            timeouts.push(setTimeout(typeNext, speed));
          };

          timeouts.push(setTimeout(typeNext, delay * 1000));
        });
      };

      const revealInto = (element, delay = 0, instant = false) => {
        if (!element) return;
        const text = element.dataset.text ?? "";
        element.textContent = "";
        element.classList.remove("text-type");

        [...text].forEach((char, index) => {
          const span = document.createElement("span");
          span.textContent = char === " " ? "\u00A0" : char;
          span.style.opacity = instant ? "1" : "0";
          element.appendChild(span);

          if (!instant) {
            gsap.to(span, {
              autoAlpha: 1,
              duration: 0.02,
              delay: delay + index * 0.055,
              ease: "none",
            });
          }
        });
      };

      const activateLetterHover = () => {
        const referenceLetters = [
          {
            letter: "S",
            paper: "#f7d83e",
            ink: "#b92a6d",
            stroke: "#8b214f",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(6% 11%, 96% 3%, 91% 93%, 10% 86%)",
            texture: "yellow-print",
            tilt: "-5deg",
            y: "-10px",
            scale: "1.2",
          },
          {
            letter: "e",
            paper: "#f7f0d8",
            ink: "#404654",
            stroke: "#2f3440",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(4% 15%, 94% 11%, 100% 86%, 12% 93%)",
            texture: "cream-paper",
            tilt: "1deg",
            y: "-4px",
            scale: "1.12",
          },
          {
            letter: "t",
            paper: "#9e7864",
            ink: "#fff7ee",
            stroke: "#fff7ee",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(16% 5%, 86% 0%, 95% 91%, 10% 100%, 0% 28%)",
            texture: "kraft",
            tilt: "-9deg",
            y: "2px",
            scale: "1.1",
          },
          {
            letter: "h",
            paper: "#a8ce69",
            ink: "#229328",
            stroke: "#0c5128",
            font: "Trebuchet MS, Arial, sans-serif",
            clip: "polygon(0% 8%, 96% 10%, 93% 97%, 5% 94%)",
            texture: "fibers",
            tilt: "2deg",
            y: "-3px",
            scale: "1.16",
          },
          {
            letter: "u",
            paper: "#f8f3ed",
            ink: "#a51e25",
            stroke: "#111111",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(5% 4%, 96% 5%, 92% 95%, 15% 100%, 0% 20%)",
            texture: "outline",
            tilt: "-2deg",
            y: "-6px",
            scale: "1.18",
          },
          {
            letter: "C",
            paper: "#d7ded7",
            ink: "#cf3e77",
            stroke: "#29334b",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(10% 0%, 93% 7%, 84% 89%, 20% 100%, 0% 24%)",
            texture: "newsprint",
            tilt: "3deg",
            y: "-9px",
            scale: "1.22",
          },
          {
            letter: "h",
            paper: "#ffec5d",
            ink: "#8e54ba",
            stroke: "#8e54ba",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(5% 0%, 88% 5%, 95% 92%, 8% 100%)",
            texture: "yellow-clean",
            tilt: "4deg",
            y: "-4px",
            scale: "1.13",
          },
          {
            letter: "A",
            paper: "#2d6fa5",
            ink: "#f4efe6",
            stroke: "#f4efe6",
            font: "Arial Black, Impact, sans-serif",
            clip: "polygon(13% 5%, 90% 0%, 100% 83%, 8% 98%, 0% 24%)",
            texture: "denim",
            tilt: "7deg",
            y: "-7px",
            scale: "1.18",
          },
          {
            letter: "n",
            paper: "#1c3d80",
            ink: "#ffad22",
            stroke: "#ffad22",
            font: "Arial Black, Impact, sans-serif",
            clip: "polygon(1% 13%, 100% 6%, 93% 92%, 7% 89%)",
            texture: "dark-print",
            tilt: "2deg",
            y: "0px",
            scale: "1.1",
          },
          {
            letter: "d",
            paper: "#f6efe5",
            ink: "#020202",
            stroke: "#020202",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(10% 0%, 91% 5%, 91% 100%, 10% 95%)",
            texture: "cream-paper",
            tilt: "-1deg",
            y: "-5px",
            scale: "1.16",
          },
          {
            letter: "r",
            paper: "#ffb34c",
            ink: "#cc1d68",
            stroke: "#cc1d68",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(6% 0%, 84% 0%, 100% 94%, 2% 91%)",
            texture: "orange-paper",
            tilt: "1deg",
            y: "-2px",
            scale: "1.1",
          },
          {
            letter: "a",
            paper: "#9b2f84",
            ink: "#f5d342",
            stroke: "#f5d342",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(12% 10%, 100% 0%, 87% 90%, 0% 95%)",
            texture: "purple-paper",
            tilt: "8deg",
            y: "-3px",
            scale: "1.13",
          },
        ];

        gsap.utils.toArray(".name-letter").forEach((letter, index) => {
          const palette = referenceLetters[index % referenceLetters.length];
          letter.style.setProperty("--scrap-paper", palette.paper);
          letter.style.setProperty("--scrap-ink", palette.ink);
          letter.style.setProperty("--scrap-stroke", palette.stroke);
          letter.style.setProperty("--scrap-font", palette.font);
          letter.style.setProperty("--scrap-clip", palette.clip);
          letter.style.setProperty("--scrap-y", palette.y);
          letter.style.setProperty("--scrap-tilt", palette.tilt);
          letter.style.setProperty("--scrap-scale", palette.scale);
          letter.dataset.texture = palette.texture;
        });
      };

      const mm = gsap.matchMedia();

      mm.add(
        {
          reduceMotion: "(prefers-reduced-motion: reduce)",
          isDesktop: "(min-width: 760px)",
          isWideDesktop: "(min-width: 981px)",
          isMobile: "(max-width: 759px)",
          isLaptop: "(min-width: 760px) and (max-width: 1600px) and (max-height: 1050px)",
        },
        (context) => {
          const { reduceMotion, isDesktop, isWideDesktop, isLaptop } = context.conditions;
          // The lockup is emptied and re-typed below in this same synchronous
          // pass, so it can be unveiled here without ever painting raw markup.
          document.documentElement.classList.remove("intro-pending");
          const introLines = gsap.utils.toArray(".typed-line");
          const stackGap = isLaptop ? 18 : isDesktop ? 22 : 18;

          if (reduceMotion) {
            revealInto(document.querySelector(".glitch-line"), 0, true);
            typeInto(document.querySelector(".name-line"), 0, true);
            activateLetterHover();
            gsap.set([".name-lockup", ".identity-line", ".hello-mark", ".latest-content", ".latest-deck", ".deck-card", ".achievement-card"], {
              autoAlpha: 1,
              clearProps: "transform",
            });
            gsap.set(".identity-word-typed", { text: "learner" });
            gsap.set(".identity-word__cursor", { autoAlpha: 0 });
            return;
          }

          revealInto(document.querySelector(".glitch-line"), 0.2);
          typeInto(document.querySelector(".name-line"), 0.86).then(activateLetterHover);
          gsap.to(".identity-word__cursor", {
            autoAlpha: 0,
            duration: 0.5,
            repeat: -1,
            yoyo: true,
            ease: "power2.inOut",
          });
          let latestTitleVisible = false;
          let openingTimeline;
          openingTimeline = gsap.timeline({
              scrollTrigger: {
                trigger: ".opening-stage",
                start: "top top",
                end: () => isWideDesktop
                  ? `+=${Math.max(window.innerHeight * 4, 3400)}`
                  : `+=${Math.max(window.innerHeight * 2.8, 1200)}`,
                scrub: 1.15,
                pin: ".opening-pin",
                invalidateOnRefresh: true,
                onUpdate: (self) => {
                  const duration = openingTimeline.duration();
                  const revealAt = duration
                    ? (openingTimeline.labels.compose + 0.2) / duration
                    : 1;
                  const shouldReveal = self.progress >= revealAt;
                  if (shouldReveal === latestTitleVisible) return;
                  latestTitleVisible = shouldReveal;
                  window.__blurTextTriggerState ??= {};
                  window.__blurTextTriggerState["latest-title-visibility"] = shouldReveal;
                  window.dispatchEvent(
                    new CustomEvent("latest-title-visibility", {
                      detail: { active: shouldReveal },
                    })
                  );
                },
              },
              defaults: { ease: "power2.inOut" },
            });

          openingTimeline
            .addLabel("identity", 0)
            .addLabel("compose", 2.05)
            .to(
              ".glitch-line",
              {
                autoAlpha: 0,
                y: -18,
                duration: 0.24,
                ease: "power1.out",
              },
              "identity"
            )
            .to(
              ".name-line",
              { autoAlpha: 0, duration: 0.28, ease: "power1.out" },
              "identity+=0.1"
            )
            .fromTo(
              ".identity-line",
              { autoAlpha: 0, y: 8, left: "50%", xPercent: -50, scale: 1 },
              { autoAlpha: 1, y: -18, duration: 0.46, ease: "power2.out" },
              "identity+=0.14"
            )
            .set(".identity-word-typed", { text: "" }, "identity")
            .to(
              ".identity-word-typed",
              { text: "builder", duration: 0.36, ease: "none" },
              "identity+=0.26"
            )
            .to(
              ".identity-word-typed",
              { text: "", duration: 0.18, ease: "none" },
              "identity+=0.7"
            )
            .to(
              ".identity-word-typed",
              { text: "storyteller", duration: 0.46, ease: "none" },
              "identity+=0.88"
            )
            .to(
              ".identity-word-typed",
              { text: "", duration: 0.2, ease: "none" },
              "identity+=1.42"
            )
            .to(
              ".identity-word-typed",
              { text: "learner", duration: 0.34, ease: "none" },
              "identity+=1.62"
            )
            .to(
              ".scroll-note",
              { autoAlpha: 1, y: 0, duration: 0.36, ease: "power2.out" },
              "identity+=0.2"
            )
            .set(
              ".name-lockup",
              {
                x: () => window.innerWidth / 2 - (isDesktop ? 28 : 18),
                y: () => window.innerHeight / 2 - (isDesktop ? 42 : 34),
                xPercent: -50,
                yPercent: -50,
              },
              "identity"
            )
            .to(
