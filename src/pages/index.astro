---
const latestEvents = [
  {
    label: "01",
    title: "Building growth systems at Mesh",
    description:
      "As a GTM Engineer at Mesh (YC W25), I build inbound and outbound growth engines for the future of enterprise finance teams.",
  },
  {
    label: "02",
    title: "Cross-country solo travel",
    description:
      "Solo travelled across the United States from the east coast to the west coast on the California Zephyr.",
  },
  {
    label: "03",
    title: "Launching Lehigh Product Society",
    description:
      "Built Lehigh University's first product management focused organization to over 50 members and ran an 8-week fellowship.",
  },
];

const accomplishments = [
  {
    title: "Cross-country solo travel",
    description:
      "Took the California Zephyr from Chicago to San Francisco for my summer internship. Met a lot of cool people on the train.",
    label: "01",
    gradient: "linear-gradient(135deg, #f5d76e, #e85d75)",
  },
  {
    title: "Eagle project",
    description: "A service project I planned, led, and brought to life from idea to execution.",
    label: "02",
    gradient: "linear-gradient(135deg, #7bdff2, #246eb9)",
  },
  {
    title: "Rappelling in front of my school",
    description: "A memorable experience that pushed me outside my comfort zone in a very public way.",
    label: "03",
    gradient: "linear-gradient(135deg, #b8f2e6, #2f9c95)",
  },
  {
    title: "TBD",
    description: "I don't know what my fourth experience is yet, but I will decide soon.",
    label: "04",
    gradient: "linear-gradient(135deg, #f7a072, #5b2333)",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Sethu Chandra portfolio, built with Astro and GSAP."
    />
    <title>Sethu Chandra | Portfolio</title>
  </head>
  <body>
    <main>
      <section class="opening-stage" aria-labelledby="intro-title">
        <div class="opening-pin">
          <div class="name-lockup" id="intro-title">
            <p class="typed-line glitch-line" data-text="Hi! I'm,"></p>
            <h1 class="typed-line name-line" data-text="Sethu Chandra"></h1>
            <p class="identity-line" aria-label="I'm a builder, learner, storyteller">
              I'm a <span class="identity-word" aria-hidden="true">builder</span>
            </p>
            <img class="hello-mark" src="/assets/hello-transparent.gif" alt="" loading="eager" aria-hidden="true" />
            <span class="scroll-note">scroll</span>
          </div>

          <nav class="social-links" aria-label="Social links and theme">
            <button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
              <span class="theme-toggle-track" aria-hidden="true">
                <span class="theme-toggle-thumb"></span>
              </span>
            </button>
            <div class="social-icon-row">
              <a href="#" aria-label="X"><span aria-hidden="true">X</span></a>
              <a href="#" aria-label="LinkedIn"><span aria-hidden="true">in</span></a>
              <a href="#" aria-label="GitHub">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.5v-1.9c-2.78.62-3.37-1.2-3.37-1.2-.45-1.2-1.11-1.52-1.11-1.52-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 5.96c.85 0 1.7.12 2.5.34 1.9-1.33 2.74-1.05 2.74-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.07.36.32.68.95.68 1.92v2.85c0 .28.18.6.69.5A10.1 10.1 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z"></path>
                </svg>
              </a>
              <a href="#" aria-label="Substack">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <path d="M5 4h14v2H5V4Zm0 4h14v2H5V8Zm0 4h14v8l-7-3.9L5 20v-8Z"></path>
                </svg>
              </a>
            </div>
          </nav>

          <div class="latest-content">
            <h2 id="latest-title">As of lately...</h2>
            <div class="latest-deck" aria-label="Recent updates">
              {
                latestEvents.map((event, index) => (
                  <article class="deck-card" style={`--card-index: ${index}; --card-count: ${latestEvents.length}`}>
                    <div class="deck-card-heading">
                      <p>{event.label}</p>
                      <h3>{event.title}</h3>
                    </div>
                    <span>{event.description}</span>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section class="experiences-section" aria-labelledby="experiences-title">
        <div class="experiences-inner">
          <h2 id="experiences-title" class="experiences-title">Experience</h2>
          <p class="experiences-subtitle">"Everything is a win when the goal is to experience."</p>
          <nav class="line-sidebar experience-sidebar" aria-label="Experience categories">
            <ul class="line-sidebar__list">
              <li class="line-sidebar__item is-active" aria-current="true" data-sidebar-item>
                <span class="line-sidebar__marker" aria-hidden="true"></span>
                <button class="line-sidebar__label" type="button">
                  <span class="line-sidebar__index">01</span>
                  <span class="line-sidebar__text">Work</span>
                </button>
              </li>
              <li class="line-sidebar__item" data-sidebar-item>
                <span class="line-sidebar__marker" aria-hidden="true"></span>
                <button class="line-sidebar__label" type="button">
                  <span class="line-sidebar__index">02</span>
                  <span class="line-sidebar__text">Content</span>
                </button>
              </li>
              <li class="line-sidebar__item" data-sidebar-item>
                <span class="line-sidebar__marker" aria-hidden="true"></span>
                <button class="line-sidebar__label" type="button">
                  <span class="line-sidebar__index">03</span>
                  <span class="line-sidebar__text">Community</span>
                </button>
              </li>
            </ul>
          </nav>
        </div>
      </section>

      <section class="carousel-section" aria-labelledby="carousel-title">
        <div class="carousel-heading">
          <p class="section-kicker">Diverse experiences I am proud of :)</p>
          <h2 id="carousel-title">Cool things I have done</h2>
        </div>

        <div class="carousel-track" aria-label="Accomplishment carousel">
          {
            accomplishments.map((item) => (
              <article class="achievement-card">
                <div class="achievement-image" style={`background: ${item.gradient}`}>
                  <span>{item.label}</span>
                </div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="world-section" aria-labelledby="world-title">
        <div class="world-heading">
          <p class="section-kicker">places, motion, memory</p>
          <h2 id="world-title">My World</h2>
        </div>
        <div
          class="circular-gallery"
          data-circular-gallery
          tabindex="0"
          role="region"
          aria-label="Circular travel gallery. Use left and right arrow keys to navigate."
        ></div>
        <div class="world-modal" data-world-modal aria-hidden="true">
          <button class="world-modal__backdrop" type="button" data-world-close aria-label="Close travel detail"></button>
          <article class="world-modal__card" role="dialog" aria-modal="true" aria-labelledby="world-modal-title">
            <button class="world-modal__close" type="button" data-world-close aria-label="Close travel detail">×</button>
            <div class="world-modal__image" data-world-modal-image></div>
            <p class="world-modal__eyebrow" data-world-modal-eyebrow></p>
            <h3 id="world-modal-title" data-world-modal-title></h3>
            <p data-world-modal-description></p>
          </article>
        </div>
      </section>
    </main>

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      import { Camera, Mesh, Plane, Program, Renderer, Texture, Transform } from "ogl";

      gsap.registerPlugin(ScrollTrigger);
      window.history.scrollRestoration = "manual";
      if (window.location.hash) {
        window.history.replaceState(null, "", window.location.pathname);
      }
      window.scrollTo(0, 0);

      const themeToggle = document.querySelector(".theme-toggle");
      const storedTheme = window.localStorage.getItem("sethu-theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const initialTheme = storedTheme || (prefersDark ? "dark" : "light");

      const setTheme = (theme) => {
        document.body.dataset.theme = theme;
        themeToggle?.setAttribute("aria-pressed", String(theme === "dark"));
        themeToggle?.setAttribute(
          "aria-label",
          theme === "dark" ? "Switch to light mode" : "Switch to dark mode"
        );
      };

      setTheme(initialTheme);

      themeToggle?.addEventListener("click", () => {
        const nextTheme = document.body.dataset.theme === "dark" ? "light" : "dark";
        setTheme(nextTheme);
        window.localStorage.setItem("sethu-theme", nextTheme);
      });

      const initExperienceSidebar = () => {
        const sidebar = document.querySelector(".experience-sidebar");
        const list = sidebar?.querySelector(".line-sidebar__list");
        const items = [...(sidebar?.querySelectorAll("[data-sidebar-item]") ?? [])];
        if (!sidebar || !list || items.length === 0) return;

        const targets = items.map((item) => (item.classList.contains("is-active") ? 1 : 0));
        const current = [...targets];
        let activeIndex = targets.findIndex((value) => value === 1);
        let rafId = 0;
        let lastTime = 0;

        const startLoop = () => {
          if (rafId) return;
          lastTime = performance.now();
          rafId = requestAnimationFrame(runFrame);
        };

        const runFrame = (now) => {
          const delta = Math.min((now - lastTime) / 1000, 0.05);
          lastTime = now;
          const smoothing = 0.12;
          const easing = 1 - Math.exp(-delta / smoothing);
          let moving = false;

          items.forEach((item, index) => {
            const target = Math.max(targets[index] || 0, activeIndex === index ? 1 : 0);
            const next = current[index] + (target - current[index]) * easing;
            const value = Math.abs(target - next) < 0.0015 ? target : next;
            current[index] = value;
            item.style.setProperty("--effect", value.toFixed(4));
            if (value !== target) moving = true;
          });

          rafId = moving ? requestAnimationFrame(runFrame) : 0;
        };

        list.addEventListener("pointermove", (event) => {
          const rect = list.getBoundingClientRect();
          const pointerY = event.clientY - rect.top;
          const radius = 110;

          items.forEach((item, index) => {
            const center = item.offsetTop + item.offsetHeight / 2;
            const distance = Math.abs(pointerY - center);
            const proximity = Math.max(0, 1 - distance / radius);
            targets[index] = proximity * proximity * (3 - 2 * proximity);
          });

          startLoop();
        });

        list.addEventListener("pointerleave", () => {
          targets.fill(0);
          startLoop();
        });

        items.forEach((item, index) => {
          item.querySelector("button")?.addEventListener("click", () => {
            activeIndex = index;
            items.forEach((nextItem, nextIndex) => {
              const isActive = nextIndex === index;
              nextItem.classList.toggle("is-active", isActive);
              if (isActive) {
                nextItem.setAttribute("aria-current", "true");
              } else {
                nextItem.removeAttribute("aria-current");
              }
            });
            startLoop();
          });
        });

        startLoop();
        window.addEventListener("pagehide", () => {
          if (rafId) cancelAnimationFrame(rafId);
        });
      };

      initExperienceSidebar();

      const initExperienceTextPressure = () => {
        const title = document.querySelector(".experiences-title");
        if (!title || title.dataset.pressureReady === "true") return;

        const text = title.textContent?.trim() || "";
        title.textContent = "";
        title.dataset.pressureReady = "true";

        const spans = [...text].map((char) => {
          const span = document.createElement("span");
          span.className = "pressure-letter";
          span.dataset.char = char;
          span.textContent = char === " " ? "\u00A0" : char;
          title.appendChild(span);
          return span;
        });

        const pointer = { x: 0, y: 0 };
        const eased = { x: 0, y: 0 };
        let hoverStrength = 0;
        let targetStrength = 0;
        let rafId = 0;

        const setToCenter = (immediate = true) => {
          const rect = title.getBoundingClientRect();
          pointer.x = rect.left + rect.width / 2;
          pointer.y = rect.top + rect.height / 2;
          if (immediate) {
            eased.x = pointer.x;
            eased.y = pointer.y;
          }
        };

        const getInfluence = (distance, maxDistance) => {
          const normalized = Math.max(0, 1 - distance / maxDistance);
          return normalized * normalized;
        };

        const resetLetters = () => {
          spans.forEach((span) => {
            span.style.fontVariationSettings = "'wght' 760, 'wdth' 100, 'opsz' 144";
            span.style.transform = "translateY(0)";
          });
        };

        const animate = () => {
          eased.x += (pointer.x - eased.x) / 18;
          eased.y += (pointer.y - eased.y) / 18;
          hoverStrength += (targetStrength - hoverStrength) / 14;

          const titleRect = title.getBoundingClientRect();
          const maxDistance = Math.max(titleRect.width * 0.55, 1);

          spans.forEach((span) => {
            const rect = span.getBoundingClientRect();
            const center = {
              x: rect.left + rect.width / 2,
              y: rect.top + rect.height / 2,
            };
            const distance = Math.hypot(eased.x - center.x, eased.y - center.y);
            const influence = getInfluence(distance, maxDistance) * hoverStrength;
            const weight = Math.floor(760 + influence * 150);
            const width = Math.floor(100 + influence * 18);
            const lift = influence * 4;

            span.style.fontVariationSettings = `'wght' ${weight}, 'wdth' ${width}, 'opsz' 144`;
            span.style.transform = `translateY(${-lift}px)`;
          });

          if (hoverStrength < 0.002 && targetStrength === 0) {
            hoverStrength = 0;
          }

          rafId = requestAnimationFrame(animate);
        };

        title.addEventListener("pointerenter", (event) => {
          targetStrength = 1;
          pointer.x = event.clientX;
          pointer.y = event.clientY;
        });

        title.addEventListener("pointermove", (event) => {
          pointer.x = event.clientX;
          pointer.y = event.clientY;
        });

        title.addEventListener("pointerleave", () => {
          targetStrength = 0;
          setToCenter(false);
        });

        window.addEventListener("resize", setToCenter);
        setToCenter();
        resetLetters();
        animate();

        window.addEventListener("pagehide", () => {
          cancelAnimationFrame(rafId);
        });
      };

      initExperienceTextPressure();

      const createTravelPlaceholder = (label, colorA, colorB, colorC) => {
        const canvas = document.createElement("canvas");
        canvas.width = 900;
        canvas.height = 650;
        const context = canvas.getContext("2d");
        const gradient = context.createLinearGradient(0, 0, canvas.width, canvas.height);
        gradient.addColorStop(0, colorA);
        gradient.addColorStop(0.55, colorB);
        gradient.addColorStop(1, colorC);
        context.fillStyle = gradient;
        context.fillRect(0, 0, canvas.width, canvas.height);

        context.fillStyle = "rgba(255,255,255,0.16)";
        for (let i = 0; i < 9; i += 1) {
          context.beginPath();
          context.arc(120 + i * 95, 120 + Math.sin(i) * 46, 92 + i * 8, 0, Math.PI * 2);
          context.fill();
        }

        context.fillStyle = "rgba(17,17,17,0.32)";
        context.fillRect(0, canvas.height - 118, canvas.width, 118);
        context.fillStyle = "#fff7ee";
        context.font = "900 58px Inter, system-ui, sans-serif";
        context.textAlign = "center";
        context.textBaseline = "middle";
        context.fillText(label, canvas.width / 2, canvas.height - 58);
        return canvas.toDataURL("image/png");
      };

      const createTextTexture = (gl, text, font, color) => {
        const canvas = document.createElement("canvas");
        const context = canvas.getContext("2d");
        context.font = font;
        const width = Math.ceil(context.measureText(text).width) + 28;
        const height = 72;
        canvas.width = width;
        canvas.height = height;
        context.font = font;
        context.fillStyle = color;
        context.textAlign = "center";
        context.textBaseline = "middle";
        context.fillText(text, width / 2, height / 2);
        const texture = new Texture(gl, { generateMipmaps: false });
        texture.image = canvas;
        return { texture, width, height };
      };

      class CircularGalleryApp {
        constructor(container, items) {
          this.container = container;
          this.items = items.concat(items);
          this.scroll = { current: 0, target: 0, last: 0, ease: 0.026 };
          this.scrollSpeed = 0.9;
          this.isDown = false;
          this.didDrag = false;
          this.createRenderer();
          this.createCamera();
          this.scene = new Transform();
          this.geometry = new Plane(this.gl, { widthSegments: 80, heightSegments: 42 });
          this.medias = [];
          this.onResize();
          this.createMedias();
          this.addEvents();
          this.update();
        }

        createRenderer() {
          this.renderer = new Renderer({
            alpha: true,
            antialias: true,
            dpr: Math.min(window.devicePixelRatio || 1, 2),
          });
          this.gl = this.renderer.gl;
          this.gl.clearColor(0, 0, 0, 0);
          this.container.appendChild(this.gl.canvas);
        }

        createCamera() {
          this.camera = new Camera(this.gl);
          this.camera.fov = 45;
          this.camera.position.z = 20;
        }

        createProgram(image, borderRadius = 0.055) {
          const texture = new Texture(this.gl, { generateMipmaps: true });
          const program = new Program(this.gl, {
            depthTest: false,
            depthWrite: false,
            transparent: true,
            vertex: `
              precision highp float;
              attribute vec3 position;
              attribute vec2 uv;
              uniform mat4 modelViewMatrix;
              uniform mat4 projectionMatrix;
              uniform float uTime;
              uniform float uSpeed;
              varying vec2 vUv;
              void main() {
                vUv = uv;
                vec3 p = position;
                p.z = (sin(p.x * 4.0 + uTime) * 1.2 + cos(p.y * 2.0 + uTime) * 1.2) * (0.06 + abs(uSpeed) * 0.35);
                gl_Position = projectionMatrix * modelViewMatrix * vec4(p, 1.0);
              }
            `,
            fragment: `
              precision highp float;
              uniform vec2 uImageSizes;
              uniform vec2 uPlaneSizes;
              uniform sampler2D tMap;
              uniform float uBorderRadius;
              varying vec2 vUv;
              float roundedBoxSDF(vec2 p, vec2 b, float r) {
                vec2 d = abs(p) - b;
                return length(max(d, vec2(0.0))) + min(max(d.x, d.y), 0.0) - r;
              }
              void main() {
                vec2 ratio = vec2(
                  min((uPlaneSizes.x / uPlaneSizes.y) / (uImageSizes.x / uImageSizes.y), 1.0),
                  min((uPlaneSizes.y / uPlaneSizes.x) / (uImageSizes.y / uImageSizes.x), 1.0)
                );
                vec2 uv = vec2(
                  vUv.x * ratio.x + (1.0 - ratio.x) * 0.5,
                  vUv.y * ratio.y + (1.0 - ratio.y) * 0.5
                );
                vec4 color = texture2D(tMap, uv);
                float d = roundedBoxSDF(vUv - 0.5, vec2(0.5 - uBorderRadius), uBorderRadius);
                float alpha = 1.0 - smoothstep(-0.002, 0.002, d);
                gl_FragColor = vec4(color.rgb, alpha);
              }
            `,
            uniforms: {
              tMap: { value: texture },
              uPlaneSizes: { value: [0, 0] },
              uImageSizes: { value: [900, 650] },
              uSpeed: { value: 0 },
              uTime: { value: 100 * Math.random() },
              uBorderRadius: { value: borderRadius },
            },
          });
          const img = new Image();
          img.onload = () => {
            texture.image = img;
            program.uniforms.uImageSizes.value = [img.naturalWidth, img.naturalHeight];
          };
          img.src = image;
          return program;
        }

        createLabel(plane, text) {
          const { texture, width, height } = createTextTexture(
            this.gl,
            text,
            "900 34px Inter, system-ui, sans-serif",
            getComputedStyle(document.body).getPropertyValue("--ink").trim() || "#111111"
          );
          const program = new Program(this.gl, {
            transparent: true,
            vertex: `
              attribute vec3 position;
              attribute vec2 uv;
              uniform mat4 modelViewMatrix;
              uniform mat4 projectionMatrix;
              varying vec2 vUv;
              void main() {
                vUv = uv;
                gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
              }
            `,
            fragment: `
              precision highp float;
              uniform sampler2D tMap;
              varying vec2 vUv;
              void main() {
                vec4 color = texture2D(tMap, vUv);
                if (color.a < 0.1) discard;
                gl_FragColor = color;
              }
            `,
            uniforms: { tMap: { value: texture } },
          });
          const mesh = new Mesh(this.gl, { geometry: new Plane(this.gl), program });
          const labelHeight = plane.scale.y * 0.15;
          mesh.scale.set(labelHeight * (width / height), labelHeight, 1);
          mesh.position.y = -plane.scale.y * 0.64;
          mesh.setParent(plane);
          return { mesh, aspect: width / height };
        }

        createMedias() {
          this.medias = this.items.map((item, index) => {
            const plane = new Mesh(this.gl, {
              geometry: this.geometry,
              program: this.createProgram(item.image),
            });
            plane.setParent(this.scene);
            const label = this.createLabel(plane, item.text);
            return { plane, label, index, extra: 0, width: 0, widthTotal: 0, x: 0 };
          });
          this.onResize();
        }

        onResize = () => {
          this.screen = {
            width: this.container.clientWidth,
            height: this.container.clientHeight,
          };
          this.renderer.setSize(this.screen.width, this.screen.height);
          this.camera.perspective({ aspect: this.screen.width / this.screen.height });
          const fov = (this.camera.fov * Math.PI) / 180;
          const height = 2 * Math.tan(fov / 2) * this.camera.position.z;
          this.viewport = { width: height * this.camera.aspect, height };
          this.medias?.forEach((media) => {
            media.plane.scale.y = this.viewport.height * 0.54;
            media.plane.scale.x = this.viewport.width * 0.3;
            media.plane.program.uniforms.uPlaneSizes.value = [media.plane.scale.x, media.plane.scale.y];
            const labelHeight = media.plane.scale.y * 0.15;
            media.label.mesh.scale.set(labelHeight * media.label.aspect, labelHeight, 1);
            media.label.mesh.position.y = -media.plane.scale.y * 0.64;
            media.width = media.plane.scale.x + 2.15;
            media.widthTotal = media.width * this.medias.length;
            media.x = media.width * media.index;
          });
        };

        updateMedia(media, direction) {
          media.plane.position.x = media.x - this.scroll.current - media.extra;
          const x = media.plane.position.x;
          const halfWidth = this.viewport.width / 2;
          const bend = 3;
          const radius = (halfWidth * halfWidth + bend * bend) / (2 * bend);
          const effectiveX = Math.min(Math.abs(x), halfWidth);
          const arc = radius - Math.sqrt(radius * radius - effectiveX * effectiveX);
          media.plane.position.y = -arc * 0.78;
          media.plane.rotation.z = -Math.sign(x) * Math.asin(effectiveX / radius) * 0.82;
          media.plane.program.uniforms.uTime.value += 0.035;
          media.plane.program.uniforms.uSpeed.value = this.scroll.current - this.scroll.last;

          const planeOffset = media.plane.scale.x / 2;
          const viewportOffset = this.viewport.width / 2;
          if (direction === "right" && media.plane.position.x + planeOffset < -viewportOffset) {
            media.extra -= media.widthTotal;
          }
          if (direction === "left" && media.plane.position.x - planeOffset > viewportOffset) {
            media.extra += media.widthTotal;
          }
        }

        onWheel = (event) => {
          const delta = event.deltaY || event.wheelDelta || event.detail;
          this.scroll.target += (delta > 0 ? this.scrollSpeed : -this.scrollSpeed) * 0.12;
        };

        onPointerDown = (event) => {
          this.isDown = true;
          this.didDrag = false;
          this.scroll.position = this.scroll.current;
          this.start = event.touches ? event.touches[0].clientX : event.clientX;
        };

        onPointerMove = (event) => {
          if (!this.isDown) return;
          const x = event.touches ? event.touches[0].clientX : event.clientX;
          if (Math.abs(x - this.start) > 6) {
            this.didDrag = true;
          }
          this.scroll.target = this.scroll.position + (this.start - x) * 0.024;
        };

        onPointerUp = () => {
          this.isDown = false;
          window.setTimeout(() => {
            this.didDrag = false;
          }, 0);
        };

        onKeyDown = (event) => {
          if (event.key === "ArrowRight") {
            this.scroll.target += this.scrollSpeed * 1.4;
          }
          if (event.key === "ArrowLeft") {
            this.scroll.target -= this.scrollSpeed * 1.4;
          }
        };

        addEvents() {
          window.addEventListener("resize", this.onResize);
          this.container.addEventListener("wheel", this.onWheel, { passive: true });
          this.container.addEventListener("mousedown", this.onPointerDown);
          window.addEventListener("mousemove", this.onPointerMove);
          window.addEventListener("mouseup", this.onPointerUp);
          this.container.addEventListener("touchstart", this.onPointerDown, { passive: true });
          window.addEventListener("touchmove", this.onPointerMove, { passive: true });
          window.addEventListener("touchend", this.onPointerUp);
          this.container.addEventListener("keydown", this.onKeyDown);
        }

        update = () => {
          this.scroll.current += (this.scroll.target - this.scroll.current) * this.scroll.ease;
          const direction = this.scroll.current > this.scroll.last ? "right" : "left";
          this.medias.forEach((media) => this.updateMedia(media, direction));
          this.renderer.render({ scene: this.scene, camera: this.camera });
          this.scroll.last = this.scroll.current;
          this.raf = requestAnimationFrame(this.update);
        };

        getCenteredItem() {
          const nearest = this.medias.reduce((closest, media) => {
            const distance = Math.abs(media.plane.position.x);
            return !closest || distance < closest.distance ? { media, distance } : closest;
          }, null);
          const originalIndex = nearest ? nearest.media.index % (this.items.length / 2) : 0;
          return this.items[originalIndex];
        }

        destroy() {
          cancelAnimationFrame(this.raf);
          window.removeEventListener("resize", this.onResize);
          this.container.removeEventListener("wheel", this.onWheel);
          this.container.removeEventListener("mousedown", this.onPointerDown);
          window.removeEventListener("mousemove", this.onPointerMove);
          window.removeEventListener("mouseup", this.onPointerUp);
          this.container.removeEventListener("touchstart", this.onPointerDown);
          window.removeEventListener("touchmove", this.onPointerMove);
          window.removeEventListener("touchend", this.onPointerUp);
          this.container.removeEventListener("keydown", this.onKeyDown);
          this.gl.canvas.remove();
        }
      }

