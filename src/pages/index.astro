  }

  .yin-yang-white-field::before,
  .yin-yang-white-field::after {
    content: "";
    position: absolute;
    left: calc(var(--curve-size) * -0.5);
    width: var(--curve-size);
    height: var(--curve-size);
    border-radius: 50%;
  }

