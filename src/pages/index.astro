        let alignFrame = 0;
        let alignTimer = 0;
        const alignTarget = () => {
          if (stopped) return;
          cancelAnimationFrame(alignFrame);
          alignFrame = requestAnimationFrame(() => {
            const targetTop = window.scrollY + target.getBoundingClientRect().top - 88;
            // Temporarily override the global smooth-scroll rule so repeated
            // stabilization passes do not chase one another while pinned
            // sections and late-loading media settle.
