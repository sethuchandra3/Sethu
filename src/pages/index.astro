---
import "../styles/global.css";
import TextPressure from "../components/TextPressure.jsx";
import WorkExperienceList from "../components/WorkExperienceList.jsx";
import ConnectSection from "../components/ConnectSection.jsx";
import ProjectsSection from "../components/ProjectsSection.jsx";
import DomeGallery from "../components/DomeGallery.jsx";
import CurvedLoop from "../components/CurvedLoop.jsx";
import DecryptedText from "../components/DecryptedText.jsx";

const latestEvents = [
  {
    label: "01",
    title: "Building growth systems at Mesh",
    description:
      "As a GTM Engineer at Mesh (YC W25), I build inbound and outbound growth engines for the future of enterprise finance teams.",
  },
  {
    label: "02",
    title: "Cross-country solo travel",
    description:
      "Solo travelled across the United States from the east coast to the west coast on the California Zephyr.",
  },
  {
    label: "03",
    title: "Launching Lehigh Product Society",
    description:
      "Built Lehigh University's first product management focused organization to over 50 members and ran an 8-week fellowship.",
  },
];

const accomplishments = [
  {
    title: "Cross-country solo travel",
    description:
      "Took the California Zephyr from Chicago to San Francisco for my summer internship. Met a lot of cool people on the train.",
    label: "01",
    gradient: "linear-gradient(135deg, #f5d76e, #e85d75)",
  },
  {
    title: "Eagle project",
    description: "A service project I planned, led, and brought to life from idea to execution.",
    label: "02",
    gradient: "linear-gradient(135deg, #7bdff2, #246eb9)",
  },
  {
    title: "Rappelling in front of my school",
    description: "A memorable experience that pushed me outside my comfort zone in a very public way.",
    label: "03",
    gradient: "linear-gradient(135deg, #b8f2e6, #2f9c95)",
  },
  {
    title: "TBD",
    description: "I don't know what my fourth experience is yet, but I will decide soon.",
    label: "04",
    gradient: "linear-gradient(135deg, #f7a072, #5b2333)",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Sethu Chandra portfolio, built with Astro and GSAP."
    />
    <title>Sethu Chandra | Portfolio</title>
  </head>
  <body>
    <main>
      <section class="opening-stage" aria-labelledby="intro-title">
        <div class="opening-pin">
          <div class="name-lockup" id="intro-title">
            <p class="typed-line glitch-line" data-text="Hi! I'm,"></p>
            <h1 class="typed-line name-line" data-text="Sethu Chandra"></h1>
            <p class="identity-line" aria-label="I'm a builder, learner, storyteller">
              I'm a <span class="identity-word" aria-hidden="true">builder</span>
            </p>
            <img class="hello-mark" src="/assets/hello-transparent.gif" alt="" loading="eager" aria-hidden="true" />
            <span class="scroll-note">scroll</span>
          </div>

          <nav class="social-links" aria-label="Social links and theme">
            <button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
              <span class="theme-toggle-track" aria-hidden="true">
                <span class="theme-toggle-thumb"></span>
              </span>
            </button>
            <div class="social-icon-row">
              <a href="#" aria-label="X"><span aria-hidden="true">X</span></a>
              <a href="#" aria-label="LinkedIn"><span aria-hidden="true">in</span></a>
              <a href="#" aria-label="GitHub">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.5v-1.9c-2.78.62-3.37-1.2-3.37-1.2-.45-1.2-1.11-1.52-1.11-1.52-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 5.96c.85 0 1.7.12 2.5.34 1.9-1.33 2.74-1.05 2.74-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.07.36.32.68.95.68 1.92v2.85c0 .28.18.6.69.5A10.1 10.1 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z"></path>
                </svg>
              </a>
              <a href="#" aria-label="Substack">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <path d="M5 4h14v2H5V4Zm0 4h14v2H5V8Zm0 4h14v8l-7-3.9L5 20v-8Z"></path>
                </svg>
              </a>
            </div>
          </nav>

          <div class="latest-content">
            <h2 id="latest-title">As of lately...</h2>
            <div class="latest-deck" aria-label="Recent updates">
              {
                latestEvents.map((event, index) => (
                  <article class="deck-card" style={`--card-index: ${index}; --card-count: ${latestEvents.length}`}>
                    <div class="deck-card-heading">
                      <p>{event.label}</p>
                      <h3>{event.title}</h3>
                    </div>
                    <span>{event.description}</span>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section class="experiences-section" aria-labelledby="experiences-title">
        <div class="experiences-inner">
          <TextPressure
            client:load
            id="experiences-title"
            className="experiences-title"
            text="Experience"
          />
          <p class="experiences-subtitle">"Everything is a win when the goal is to experience."</p>
          <nav class="experience-island" aria-label="Experience categories" data-experience-toggle data-active="work">
            <span class="yin-yang-surface" aria-hidden="true">
              <span class="yin-yang-white-field"></span>
            </span>
            <button class="yin-yang-option is-active" type="button" aria-pressed="true" data-experience-option="work">
              Work
            </button>
            <button class="yin-yang-option" type="button" aria-pressed="false" data-experience-option="community">
              Community
            </button>
          </nav>
          <div class="experience-panels">
            <section class="experience-panel" data-experience-panel="work" aria-label="Work experience">
              <WorkExperienceList client:visible />
            </section>
            <section class="experience-panel experience-coming-soon" data-experience-panel="community" aria-label="Community experience" hidden>
              <p>Community experiences coming soon.</p>
            </section>
          </div>
        </div>
      </section>

      <ProjectsSection client:load />

      <section class="carousel-section" aria-labelledby="carousel-title">
        <div class="carousel-heading">
          <CurvedLoop
            client:visible
            id="carousel-title"
            ariaLabel="Cool things I have done"
            marqueeText="Cool things I have done ✦"
            speed={0.65}
            curveAmount={115}
            direction="left"
            interactive={false}
            className="carousel-curved-text"
          />
          <p class="section-kicker">Diverse experiences I am proud of :)</p>
        </div>

        <div class="carousel-track" aria-label="Accomplishment carousel">
          {
            accomplishments.map((item) => (
              <article class="achievement-card">
                <div class="achievement-image" style={`background: ${item.gradient}`}>
                  <span>{item.label}</span>
                </div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="world-section" aria-labelledby="world-title">
        <div class="world-heading">
          <h2 id="world-title">
            <DecryptedText
              client:visible
              text="My World"
              speed={68}
              sequential={true}
              revealDirection="center"
              animateOn="view"
              parentClassName="world-decrypted-text"
              className="world-decrypted__revealed"
              encryptedClassName="world-decrypted__encrypted"
            />
          </h2>
          <p class="world-subtitle">Places I’ve travelled to and called home.</p>
        </div>
        <div class="dome-gallery-shell">
          <DomeGallery client:visible />
        </div>
      </section>

      <ConnectSection client:visible />
    </main>

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);
      window.history.scrollRestoration = "manual";
      if (window.location.hash) {
        window.history.replaceState(null, "", window.location.pathname);
      }
      window.scrollTo(0, 0);

      const themeToggle = document.querySelector(".theme-toggle");
      const storedTheme = window.localStorage.getItem("sethu-theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const initialTheme = storedTheme || (prefersDark ? "dark" : "light");

      const setTheme = (theme) => {
        document.body.dataset.theme = theme;
        themeToggle?.setAttribute("aria-pressed", String(theme === "dark"));
        themeToggle?.setAttribute(
          "aria-label",
          theme === "dark" ? "Switch to light mode" : "Switch to dark mode"
        );
      };

      setTheme(initialTheme);

      themeToggle?.addEventListener("click", () => {
        const nextTheme = document.body.dataset.theme === "dark" ? "light" : "dark";
        setTheme(nextTheme);
        window.localStorage.setItem("sethu-theme", nextTheme);
      });

      const initExperienceToggle = () => {
        const island = document.querySelector("[data-experience-toggle]");
        if (!island) return;

        const options = [...island.querySelectorAll("[data-experience-option]")];
        const panels = [...document.querySelectorAll("[data-experience-panel]")];
        options.forEach((option) => {
          option.addEventListener("click", () => {
            const value = option.dataset.experienceOption || "work";
            island.dataset.active = value;

            options.forEach((nextOption) => {
              const isActive = nextOption === option;
              nextOption.classList.toggle("is-active", isActive);
              nextOption.setAttribute("aria-pressed", String(isActive));
            });

            panels.forEach((panel) => {
              panel.hidden = panel.dataset.experiencePanel !== value;
            });
          });
        });
      };

      initExperienceToggle();


      const typeInto = (element, delay = 0, instant = false) => {
        if (!element) return Promise.resolve();
        element._typewriterCleanup?.();

        const text = element.dataset.text ?? "";
        const shouldMakeInteractive = element.classList.contains("name-line");
        element.textContent = "";
        element.classList.add("text-type");

        const content = document.createElement("span");
        content.className = "text-type__content";
        element.appendChild(content);

        const appendChar = (char) => {
          const span = document.createElement("span");
          span.textContent = char === " " ? "\u00A0" : char;
          if (shouldMakeInteractive && char !== " ") {
            span.className = "name-letter";
            span.dataset.letter = char;
            span.tabIndex = 0;
          }
          content.appendChild(span);
        };

        if (instant) {
          [...text].forEach(appendChar);
          return Promise.resolve();
        }

        const cursor = document.createElement("span");
        cursor.className = "text-type__cursor";
        cursor.textContent = "|";
        element.appendChild(cursor);

        const timeouts = [];
        const cursorTween = gsap.to(cursor, {
          opacity: 0,
          duration: 0.5,
          repeat: -1,
          yoyo: true,
          ease: "power2.inOut",
        });

        element._typewriterCleanup = () => {
          timeouts.forEach((timeout) => clearTimeout(timeout));
          cursorTween.kill();
          cursor.remove();
        };

        return new Promise((resolve) => {
          let index = 0;

          const typeNext = () => {
            if (index >= text.length) {
              gsap.to(cursor, {
                autoAlpha: 0,
                duration: 0.22,
                delay: 0.12,
                onComplete: () => {
                  element._typewriterCleanup?.();
                  element._typewriterCleanup = null;
                  resolve();
                },
              });
              return;
            }

            appendChar(text[index]);
            index += 1;
            const speed = 48 + Math.random() * 42;
            timeouts.push(setTimeout(typeNext, speed));
          };

          timeouts.push(setTimeout(typeNext, delay * 1000));
        });
      };

      const revealInto = (element, delay = 0, instant = false) => {
        if (!element) return;
        const text = element.dataset.text ?? "";
        element.textContent = "";
        element.classList.remove("text-type");

        [...text].forEach((char, index) => {
          const span = document.createElement("span");
          span.textContent = char === " " ? "\u00A0" : char;
          span.style.opacity = instant ? "1" : "0";
          element.appendChild(span);

          if (!instant) {
            gsap.to(span, {
              autoAlpha: 1,
              duration: 0.02,
              delay: delay + index * 0.055,
              ease: "none",
            });
          }
        });
      };

      const activateLetterHover = () => {
        const referenceLetters = [
          {
            letter: "S",
            paper: "#f7d83e",
            ink: "#b92a6d",
            stroke: "#8b214f",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(6% 11%, 96% 3%, 91% 93%, 10% 86%)",
            texture: "yellow-print",
            tilt: "-5deg",
            y: "-10px",
            scale: "1.2",
          },
          {
            letter: "e",
            paper: "#f7f0d8",
            ink: "#404654",
            stroke: "#2f3440",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(4% 15%, 94% 11%, 100% 86%, 12% 93%)",
            texture: "cream-paper",
            tilt: "1deg",
            y: "-4px",
            scale: "1.12",
          },
          {
            letter: "t",
            paper: "#9e7864",
            ink: "#fff7ee",
            stroke: "#fff7ee",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(16% 5%, 86% 0%, 95% 91%, 10% 100%, 0% 28%)",
            texture: "kraft",
            tilt: "-9deg",
            y: "2px",
            scale: "1.1",
          },
          {
            letter: "h",
            paper: "#a8ce69",
            ink: "#229328",
            stroke: "#0c5128",
            font: "Trebuchet MS, Arial, sans-serif",
            clip: "polygon(0% 8%, 96% 10%, 93% 97%, 5% 94%)",
            texture: "fibers",
            tilt: "2deg",
            y: "-3px",
            scale: "1.16",
          },
          {
            letter: "u",
            paper: "#f8f3ed",
            ink: "#a51e25",
            stroke: "#111111",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(5% 4%, 96% 5%, 92% 95%, 15% 100%, 0% 20%)",
            texture: "outline",
            tilt: "-2deg",
            y: "-6px",
            scale: "1.18",
          },
          {
            letter: "C",
            paper: "#d7ded7",
            ink: "#cf3e77",
            stroke: "#29334b",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(10% 0%, 93% 7%, 84% 89%, 20% 100%, 0% 24%)",
            texture: "newsprint",
            tilt: "3deg",
            y: "-9px",
            scale: "1.22",
          },
          {
            letter: "h",
            paper: "#ffec5d",
            ink: "#8e54ba",
            stroke: "#8e54ba",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(5% 0%, 88% 5%, 95% 92%, 8% 100%)",
            texture: "yellow-clean",
            tilt: "4deg",
            y: "-4px",
            scale: "1.13",
          },
          {
            letter: "A",
            paper: "#2d6fa5",
            ink: "#f4efe6",
            stroke: "#f4efe6",
            font: "Arial Black, Impact, sans-serif",
            clip: "polygon(13% 5%, 90% 0%, 100% 83%, 8% 98%, 0% 24%)",
            texture: "denim",
            tilt: "7deg",
            y: "-7px",
            scale: "1.18",
          },
          {
            letter: "n",
            paper: "#1c3d80",
            ink: "#ffad22",
            stroke: "#ffad22",
            font: "Arial Black, Impact, sans-serif",
            clip: "polygon(1% 13%, 100% 6%, 93% 92%, 7% 89%)",
            texture: "dark-print",
            tilt: "2deg",
            y: "0px",
            scale: "1.1",
          },
          {
            letter: "d",
            paper: "#f6efe5",
            ink: "#020202",
            stroke: "#020202",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(10% 0%, 91% 5%, 91% 100%, 10% 95%)",
            texture: "cream-paper",
            tilt: "-1deg",
            y: "-5px",
            scale: "1.16",
          },
          {
            letter: "r",
            paper: "#ffb34c",
            ink: "#cc1d68",
            stroke: "#cc1d68",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(6% 0%, 84% 0%, 100% 94%, 2% 91%)",
            texture: "orange-paper",
            tilt: "1deg",
            y: "-2px",
            scale: "1.1",
          },
          {
            letter: "a",
            paper: "#9b2f84",
            ink: "#f5d342",
            stroke: "#f5d342",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(12% 10%, 100% 0%, 87% 90%, 0% 95%)",
            texture: "purple-paper",
            tilt: "8deg",
            y: "-3px",
            scale: "1.13",
          },
        ];

        gsap.utils.toArray(".name-letter").forEach((letter, index) => {
          const palette = referenceLetters[index % referenceLetters.length];
          letter.style.setProperty("--scrap-paper", palette.paper);
          letter.style.setProperty("--scrap-ink", palette.ink);
          letter.style.setProperty("--scrap-stroke", palette.stroke);
          letter.style.setProperty("--scrap-font", palette.font);
          letter.style.setProperty("--scrap-clip", palette.clip);
          letter.style.setProperty("--scrap-y", palette.y);
          letter.style.setProperty("--scrap-tilt", palette.tilt);
          letter.style.setProperty("--scrap-scale", palette.scale);
          letter.dataset.texture = palette.texture;
        });
      };

      const startIdentityWords = (reduceMotion = false) => {
        const word = document.querySelector(".identity-word");
        if (!word || word.dataset.ready === "true") return;
        word.dataset.ready = "true";

        const words = ["builder", "learner", "storyteller"];
        if (reduceMotion) {
          word.textContent = words.join(", ");
          return;
        }

        word.classList.add("text-type");
        word.textContent = "";
        const content = document.createElement("span");
        content.className = "text-type__content";
        const cursor = document.createElement("span");
        cursor.className = "text-type__cursor identity-word__cursor";
        cursor.textContent = "|";
        word.append(content, cursor);

        const cursorTween = gsap.to(cursor, {
          opacity: 0,
          duration: 0.5,
          repeat: -1,
          yoyo: true,
          ease: "power2.inOut",
        });
        const timeouts = [];

        const queue = (callback, delay) => {
          const timeout = window.setTimeout(callback, delay);
          timeouts.push(timeout);
        };

        let index = 0;
        const typeCurrentWord = () => {
          const current = words[index];
          let charIndex = 0;

          const typeNext = () => {
            content.textContent = current.slice(0, charIndex + 1);
            charIndex += 1;
            if (charIndex < current.length) {
              queue(typeNext, 48 + Math.random() * 42);
              return;
            }
            queue(deleteCurrent, 1050);
          };

          const deleteCurrent = () => {
            content.textContent = current.slice(0, charIndex - 1);
            charIndex -= 1;
            if (charIndex > 0) {
              queue(deleteCurrent, 32);
              return;
            }
            index = (index + 1) % words.length;
            queue(typeCurrentWord, 240);
          };

          queue(typeNext, 350);
        };

        typeCurrentWord();

        window.addEventListener("pagehide", () => {
          timeouts.forEach((timeout) => window.clearTimeout(timeout));
          cursorTween.kill();
        });
      };

      const mm = gsap.matchMedia();

      mm.add(
        {
          reduceMotion: "(prefers-reduced-motion: reduce)",
          isDesktop: "(min-width: 760px)",
        },
        (context) => {
          const { reduceMotion, isDesktop } = context.conditions;
          const introLines = gsap.utils.toArray(".typed-line");

          if (reduceMotion) {
            revealInto(document.querySelector(".glitch-line"), 0, true);
            typeInto(document.querySelector(".name-line"), 0, true);
            activateLetterHover();
            startIdentityWords(true);
            gsap.set([".name-lockup", ".identity-line", ".hello-mark", ".social-links", ".latest-content", ".latest-deck", ".deck-card", ".achievement-card"], {
              autoAlpha: 1,
              clearProps: "transform",
            });
            return;
          }

          revealInto(document.querySelector(".glitch-line"), 0.2);
          typeInto(document.querySelector(".name-line"), 0.86).then(activateLetterHover);
          startIdentityWords();

          const openingTimeline = gsap.timeline({
              scrollTrigger: {
                trigger: ".opening-stage",
                start: "top top",
                end: "+=2200",
                scrub: 1.15,
                pin: ".opening-pin",
                invalidateOnRefresh: true,
              },
              defaults: { ease: "power2.inOut" },
            });

          openingTimeline
            .addLabel("settle", 0)
            .to(
              [".glitch-line", ".scroll-note"],
              {
                autoAlpha: 0,
                y: -18,
                duration: 0.22,
                ease: "power1.out",
              },
              "settle"
            )
            .fromTo(
              ".name-lockup",
              { left: "50%", top: "50%", xPercent: -50, yPercent: -50 },
              {
                left: isDesktop ? "28px" : "18px",
                top: isDesktop ? "42px" : "34px",
                xPercent: 0,
                yPercent: 0,
              }
            )
            .to(".name-lockup", { textAlign: "left", ease: "power1.out" }, "settle+=0.08")
            .to(
              ".name-line",
              {
                fontSize: isDesktop ? "clamp(2rem, 4.2vw, 4.25rem)" : "clamp(2.35rem, 13vw, 3.8rem)",
              },
              "settle"
            )
            .fromTo(
              ".identity-line",
              { autoAlpha: 0, y: 12 },
              { autoAlpha: 1, y: 0, ease: "power2.out" },
              "settle+=0.32"
            )
            .fromTo(
              ".hello-mark",
              { autoAlpha: 0, y: 14 },
              { autoAlpha: 1, y: 0, ease: "power2.out" },
              "settle+=0.4"
            )
            .fromTo(
              ".social-links",
              { autoAlpha: 0, x: 34 },
              { autoAlpha: 1, x: 0, ease: "power2.out" },
              "settle+=0.3"
            )
            .fromTo(
              ".latest-content",
              { autoAlpha: 0, x: isDesktop ? 220 : 80, y: isDesktop ? 42 : 24 },
              { autoAlpha: 1, x: 0, y: 0, ease: "power2.out" },
              "settle+=0.24"
            )
            .fromTo(
              ".latest-deck",
              { autoAlpha: 0, y: 36 },
              { autoAlpha: 1, y: 0, duration: 0.3, ease: "power2.out" },
              "settle+=0.54"
            )
            .fromTo(
              ".deck-card",
              {
                autoAlpha: 1,
                y: (index) => (index === 0 ? 0 : 94 + (index - 1) * 94),
                scale: (index) => 1 - index * 0.028,
                minHeight: (index) => (index === 0 ? "clamp(190px, 16vw, 236px)" : "clamp(150px, 13vw, 188px)"),
                paddingTop: (index) => (index === 0 ? "clamp(24px, 3.2vw, 40px)" : "clamp(112px, 11vw, 142px)"),
                paddingBottom: (index) => (index === 0 ? "clamp(24px, 3.2vw, 40px)" : "18px"),
                rowGap: (index) => (index === 0 ? "clamp(18px, 2.8vw, 32px)" : "0px"),
