---
import "../styles/global.css";
import ConnectSection from "../components/ConnectSection.jsx";
import ProjectsSection from "../components/ProjectsSection.jsx";
import DomeGallery from "../components/DomeGallery.jsx";
import DecryptedText from "../components/DecryptedText.jsx";
import ExperienceSection from "../components/ExperienceSection.jsx";
import CoolThingsSection from "../components/CoolThingsSection.jsx";
import AboutSection from "../components/AboutSection.jsx";
import HeaderDock from "../components/HeaderDock.jsx";
import BlurText from "../components/BlurText.jsx";
import FluidGlassCursor from "../components/FluidGlassCursor.jsx";
import geistUrl from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import robotoFlexUrl from "@fontsource-variable/roboto-flex/files/roboto-flex-latin-full-normal.woff2?url";

const latestEvents = [
  {
    label: "01",
    title: "Creating growth engines at Mesh",
    titlePrefix: "Creating growth engines at ",
    linkText: "Mesh",
    linkKey: "mesh",
    companyUrl: "https://www.usemesh.com/",
  },
  {
    label: "02",
    title: "Investing in the future at Bouken Capital",
    titlePrefix: "Investing in the future at ",
    linkText: "Bouken Capital",
    linkKey: "bouken",
    companyUrl: "https://www.boukencapital.com/",
  },
  {
    label: "03",
    title: "Building Lehigh Product Society",
    titlePrefix: "Building ",
    linkText: "Lehigh Product Society",
    linkKey: "lehigh-product-society",
    companyUrl: "https://lehighproductsociety.org/",
  },
];

// Temporary launch flag: switch to true to restore My World exactly as authored.
const SHOW_MY_WORLD = false;

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={robotoFlexUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Sethu Chandra portfolio, built with Astro and GSAP."
    />
    <title>Sethu Chandra | Portfolio</title>
  </head>
  <body>
    <FluidGlassCursor client:load />
    <HeaderDock client:load />
    <main>
      <section id="top" class="opening-stage" aria-labelledby="intro-title">
        <div class="opening-pin">
          <div class="name-lockup" id="intro-title">
            <p class="typed-line glitch-line" data-text="Hi! I'm,"></p>
            <h1 class="typed-line name-line" data-text="Sethu Chandra"></h1>
            <p class="identity-line" aria-label="I'm a builder, storyteller, learner">
              <span class="identity-prefix">I'm a</span>
              <span class="identity-word" aria-hidden="true">
                <span class="identity-word-typed">builder</span>
                <span class="text-type__cursor identity-word__cursor">|</span>
              </span>
            </p>
            <span class="scroll-note">scroll</span>
          </div>

          <span class="hello-mark" aria-hidden="true">
            <img src="/assets/hello-transparent.gif" alt="" loading="eager" />
          </span>

          <div class="latest-content">
            <h2 id="latest-title">
              <BlurText
                as="span"
                text="As of lately..."
                delay={150}
                animateBy="words"
                direction="top"
                stepDuration={0.42}
                threshold={0.1}
                triggerEvent="latest-title-visibility"
                className="latest-title-blur"
                client:load
              />
            </h2>
            <div class="latest-deck" aria-label="Recent updates">
              {
                latestEvents.map((event, index) => (
                  <article
                    class={`deck-card${index === 0 ? " deck-card--mesh" : ""}`}
                    style={`--card-index: ${index}; --card-count: ${latestEvents.length}`}
                  >
                    <div class="deck-card-content">
                      <div class="deck-card-heading">
                        <p>{event.label}</p>
                        <h3>
                          {
                            event.companyUrl ? (
                              <>
                                {event.titlePrefix}
                                <a
                                  class={`company-link${event.linkKey === "mesh" ? " company-link--mesh" : ""}`}
                                  href={event.companyUrl}
                                  target="_blank"
                                  rel="noreferrer"
                                >
                                  {event.linkText}
                                  {event.linkKey === "mesh" && (
                                    <img src="/assets/mesh-mark-blue.png" alt="" aria-hidden="true" />
                                  )}
                                </a>
                              </>
                            ) : (
                              event.title
                            )
                          }
                        </h3>
                      </div>
                    </div>
                    <div class="deck-card-peek" aria-hidden="true">
                      <p>{event.label}</p>
                      <h3>{event.title}</h3>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <AboutSection client:load />

      <ExperienceSection client:load />

      <ProjectsSection client:load />

      <CoolThingsSection client:load />

      {
        SHOW_MY_WORLD && (
          <section class="world-section" aria-labelledby="world-title">
            <div class="world-heading">
              <h2 id="world-title">
                <DecryptedText
                  client:visible
                  text="My World"
                  speed={58}
                  sequential={true}
                  revealDirection="start"
                  characters="ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!?@#$%"
                  animateOn="view"
                  parentClassName="world-decrypted-text"
                  className="world-decrypted__revealed"
                  encryptedClassName="world-decrypted__encrypted"
                />
              </h2>
              <p class="world-subtitle">
                <DecryptedText
                  client:visible
                  text="Places I’ve travelled to and called home."
                  speed={30}
                  sequential={true}
                  revealDirection="start"
                  characters="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!?@#$%"
                  animateOn="view"
                  parentClassName="world-subtitle-decrypted"
                  className="world-decrypted__revealed"
                  encryptedClassName="world-decrypted__encrypted"
                />
              </p>
            </div>
            <div class="dome-gallery-shell">
              <DomeGallery
                client:only="react"
                fit={0.8}
                minRadius={600}
                maxVerticalRotationDeg={10}
                segments={34}
                grayscale={false}
                imageFilter="saturate(0.94) contrast(1.03) brightness(0.96) sepia(0.08) hue-rotate(-6deg)"
              />
            </div>
          </section>
        )
      }

      <ConnectSection client:load />
    </main>

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      import { TextPlugin } from "gsap/TextPlugin";

      gsap.registerPlugin(ScrollTrigger, TextPlugin);
      window.history.scrollRestoration = "manual";
      if (window.location.hash) {
        window.history.replaceState(null, "", window.location.pathname);
      }
      window.scrollTo(0, 0);

      const storedTheme = window.localStorage.getItem("sethu-theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const initialTheme = storedTheme || (prefersDark ? "dark" : "light");
      document.body.dataset.theme = initialTheme;

      const typeInto = (element, delay = 0, instant = false) => {
        if (!element) return Promise.resolve();
        element._typewriterCleanup?.();

        const text = element.dataset.text ?? "";
        const shouldMakeInteractive = element.classList.contains("name-line");
        element.textContent = "";
        element.classList.add("text-type");

        const content = document.createElement("span");
        content.className = "text-type__content";
        element.appendChild(content);

        const appendChar = (char) => {
          const span = document.createElement("span");
          span.textContent = char === " " ? "\u00A0" : char;
          if (shouldMakeInteractive && char !== " ") {
            span.className = "name-letter";
            span.dataset.letter = char;
            span.tabIndex = 0;
          }
          content.appendChild(span);
        };

        if (instant) {
          [...text].forEach(appendChar);
          return Promise.resolve();
        }

        const cursor = document.createElement("span");
        cursor.className = "text-type__cursor";
        cursor.textContent = "|";
        element.appendChild(cursor);

        const timeouts = [];
        const cursorTween = gsap.to(cursor, {
          opacity: 0,
          duration: 0.5,
          repeat: -1,
          yoyo: true,
          ease: "power2.inOut",
        });

        element._typewriterCleanup = () => {
          timeouts.forEach((timeout) => clearTimeout(timeout));
          cursorTween.kill();
          cursor.remove();
        };

        return new Promise((resolve) => {
          let index = 0;

          const typeNext = () => {
            if (index >= text.length) {
              gsap.to(cursor, {
                autoAlpha: 0,
                duration: 0.22,
                delay: 0.12,
                onComplete: () => {
                  element._typewriterCleanup?.();
                  element._typewriterCleanup = null;
                  resolve();
                },
              });
              return;
            }

            appendChar(text[index]);
            index += 1;
            const speed = 48 + Math.random() * 42;
            timeouts.push(setTimeout(typeNext, speed));
          };

          timeouts.push(setTimeout(typeNext, delay * 1000));
        });
      };

      const revealInto = (element, delay = 0, instant = false) => {
        if (!element) return;
        const text = element.dataset.text ?? "";
        element.textContent = "";
        element.classList.remove("text-type");

        [...text].forEach((char, index) => {
          const span = document.createElement("span");
          span.textContent = char === " " ? "\u00A0" : char;
          span.style.opacity = instant ? "1" : "0";
          element.appendChild(span);

          if (!instant) {
            gsap.to(span, {
              autoAlpha: 1,
              duration: 0.02,
              delay: delay + index * 0.055,
              ease: "none",
            });
          }
        });
      };

      const activateLetterHover = () => {
        const referenceLetters = [
          {
            letter: "S",
            paper: "#f7d83e",
            ink: "#b92a6d",
            stroke: "#8b214f",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(6% 11%, 96% 3%, 91% 93%, 10% 86%)",
            texture: "yellow-print",
            tilt: "-5deg",
            y: "-10px",
            scale: "1.2",
          },
          {
            letter: "e",
            paper: "#f7f0d8",
            ink: "#404654",
            stroke: "#2f3440",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(4% 15%, 94% 11%, 100% 86%, 12% 93%)",
            texture: "cream-paper",
            tilt: "1deg",
            y: "-4px",
            scale: "1.12",
          },
          {
            letter: "t",
            paper: "#9e7864",
            ink: "#fff7ee",
            stroke: "#fff7ee",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(16% 5%, 86% 0%, 95% 91%, 10% 100%, 0% 28%)",
            texture: "kraft",
            tilt: "-9deg",
            y: "2px",
            scale: "1.1",
          },
          {
            letter: "h",
            paper: "#a8ce69",
            ink: "#229328",
            stroke: "#0c5128",
            font: "Trebuchet MS, Arial, sans-serif",
            clip: "polygon(0% 8%, 96% 10%, 93% 97%, 5% 94%)",
            texture: "fibers",
            tilt: "2deg",
            y: "-3px",
            scale: "1.16",
          },
          {
            letter: "u",
            paper: "#f8f3ed",
            ink: "#a51e25",
            stroke: "#111111",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(5% 4%, 96% 5%, 92% 95%, 15% 100%, 0% 20%)",
            texture: "outline",
            tilt: "-2deg",
            y: "-6px",
            scale: "1.18",
          },
          {
            letter: "C",
            paper: "#d7ded7",
            ink: "#cf3e77",
            stroke: "#29334b",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(10% 0%, 93% 7%, 84% 89%, 20% 100%, 0% 24%)",
            texture: "newsprint",
            tilt: "3deg",
            y: "-9px",
            scale: "1.22",
          },
          {
            letter: "h",
            paper: "#ffec5d",
            ink: "#8e54ba",
            stroke: "#8e54ba",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(5% 0%, 88% 5%, 95% 92%, 8% 100%)",
            texture: "yellow-clean",
            tilt: "4deg",
            y: "-4px",
            scale: "1.13",
          },
          {
            letter: "A",
            paper: "#2d6fa5",
            ink: "#f4efe6",
            stroke: "#f4efe6",
            font: "Arial Black, Impact, sans-serif",
            clip: "polygon(13% 5%, 90% 0%, 100% 83%, 8% 98%, 0% 24%)",
            texture: "denim",
            tilt: "7deg",
            y: "-7px",
            scale: "1.18",
          },
          {
            letter: "n",
            paper: "#1c3d80",
            ink: "#ffad22",
            stroke: "#ffad22",
            font: "Arial Black, Impact, sans-serif",
            clip: "polygon(1% 13%, 100% 6%, 93% 92%, 7% 89%)",
            texture: "dark-print",
            tilt: "2deg",
            y: "0px",
            scale: "1.1",
          },
          {
            letter: "d",
            paper: "#f6efe5",
            ink: "#020202",
            stroke: "#020202",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(10% 0%, 91% 5%, 91% 100%, 10% 95%)",
            texture: "cream-paper",
            tilt: "-1deg",
            y: "-5px",
            scale: "1.16",
          },
          {
            letter: "r",
            paper: "#ffb34c",
            ink: "#cc1d68",
            stroke: "#cc1d68",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(6% 0%, 84% 0%, 100% 94%, 2% 91%)",
            texture: "orange-paper",
            tilt: "1deg",
            y: "-2px",
            scale: "1.1",
          },
          {
            letter: "a",
            paper: "#9b2f84",
            ink: "#f5d342",
            stroke: "#f5d342",
            font: "Georgia, 'Times New Roman', serif",
            clip: "polygon(12% 10%, 100% 0%, 87% 90%, 0% 95%)",
            texture: "purple-paper",
            tilt: "8deg",
            y: "-3px",
            scale: "1.13",
          },
        ];

        gsap.utils.toArray(".name-letter").forEach((letter, index) => {
          const palette = referenceLetters[index % referenceLetters.length];
          letter.style.setProperty("--scrap-paper", palette.paper);
          letter.style.setProperty("--scrap-ink", palette.ink);
          letter.style.setProperty("--scrap-stroke", palette.stroke);
          letter.style.setProperty("--scrap-font", palette.font);
          letter.style.setProperty("--scrap-clip", palette.clip);
          letter.style.setProperty("--scrap-y", palette.y);
          letter.style.setProperty("--scrap-tilt", palette.tilt);
          letter.style.setProperty("--scrap-scale", palette.scale);
          letter.dataset.texture = palette.texture;
        });
      };

      const mm = gsap.matchMedia();

      mm.add(
        {
          reduceMotion: "(prefers-reduced-motion: reduce)",
          isDesktop: "(min-width: 760px)",
        },
        (context) => {
          const { reduceMotion, isDesktop } = context.conditions;
          const introLines = gsap.utils.toArray(".typed-line");
          const stackGap = isDesktop ? 22 : 18;

          if (reduceMotion) {
            revealInto(document.querySelector(".glitch-line"), 0, true);
            typeInto(document.querySelector(".name-line"), 0, true);
            activateLetterHover();
            gsap.set([".name-lockup", ".identity-line", ".hello-mark", ".latest-content", ".latest-deck", ".deck-card", ".achievement-card"], {
              autoAlpha: 1,
              clearProps: "transform",
            });
            gsap.set(".identity-word-typed", { text: "learner" });
            gsap.set(".identity-word__cursor", { autoAlpha: 0 });
            return;
          }

          revealInto(document.querySelector(".glitch-line"), 0.2);
          typeInto(document.querySelector(".name-line"), 0.86).then(activateLetterHover);
          gsap.to(".identity-word__cursor", {
            autoAlpha: 0,
            duration: 0.5,
            repeat: -1,
            yoyo: true,
            ease: "power2.inOut",
          });
          let latestTitleVisible = false;
          let openingTimeline;
          openingTimeline = gsap.timeline({
              scrollTrigger: {
                trigger: ".opening-stage",
                start: "top top",
                end: () => `+=${Math.max(window.innerHeight * 4, 3400)}`,
                scrub: 1.15,
                pin: ".opening-pin",
                invalidateOnRefresh: true,
                onUpdate: (self) => {
                  const duration = openingTimeline.duration();
                  const revealAt = duration
                    ? (openingTimeline.labels.compose + 0.2) / duration
                    : 1;
                  const shouldReveal = self.progress >= revealAt;
                  if (shouldReveal === latestTitleVisible) return;
                  latestTitleVisible = shouldReveal;
                  window.__blurTextTriggerState ??= {};
                  window.__blurTextTriggerState["latest-title-visibility"] = shouldReveal;
                  window.dispatchEvent(
                    new CustomEvent("latest-title-visibility", {
                      detail: { active: shouldReveal },
                    })
                  );
                },
              },
              defaults: { ease: "power2.inOut" },
            });

          openingTimeline
            .addLabel("identity", 0)
            .addLabel("compose", 2.05)
            .to(
              ".glitch-line",
              {
                autoAlpha: 0,
                y: -18,
                duration: 0.24,
                ease: "power1.out",
              },
              "identity"
            )
            .to(
              ".name-line",
              { autoAlpha: 0, duration: 0.28, ease: "power1.out" },
              "identity+=0.1"
            )
            .fromTo(
              ".identity-line",
              { autoAlpha: 0, y: 8, left: "50%", xPercent: -50, scale: 1 },
              { autoAlpha: 1, y: -18, duration: 0.46, ease: "power2.out" },
              "identity+=0.14"
            )
            .set(".identity-word-typed", { text: "" }, "identity")
            .to(
              ".identity-word-typed",
              { text: "builder", duration: 0.36, ease: "none" },
              "identity+=0.26"
            )
            .to(
              ".identity-word-typed",
              { text: "", duration: 0.18, ease: "none" },
              "identity+=0.7"
            )
            .to(
              ".identity-word-typed",
              { text: "storyteller", duration: 0.46, ease: "none" },
              "identity+=0.88"
            )
            .to(
              ".identity-word-typed",
              { text: "", duration: 0.2, ease: "none" },
              "identity+=1.42"
            )
            .to(
              ".identity-word-typed",
              { text: "learner", duration: 0.34, ease: "none" },
              "identity+=1.62"
            )
            .to(
              ".scroll-note",
              { autoAlpha: 1, y: 0, duration: 0.36, ease: "power2.out" },
              "identity+=0.2"
            )
            .set(
              ".name-lockup",
              {
                x: () => window.innerWidth / 2 - (isDesktop ? 28 : 18),
                y: () => window.innerHeight / 2 - (isDesktop ? 42 : 34),
                xPercent: -50,
                yPercent: -50,
              },
              "identity"
            )
            .to(
              ".name-lockup",
              { autoAlpha: 0, y: "-=22", duration: 0.48, ease: "power2.inOut" },
              "compose"
            )
            .to(
              ".scroll-note",
              { autoAlpha: 0, y: -10, duration: 0.24, ease: "power1.out" },
              "compose"
            )
            .fromTo(
              ".hello-mark",
              { autoAlpha: 0, y: 28, scale: 1.06 },
              { autoAlpha: 1, y: 0, scale: 1, duration: 0.62, ease: "power2.out" },
              "compose+=0.22"
            )
            .fromTo(
              ".latest-content",
              { autoAlpha: 0, x: isDesktop ? 220 : 80, y: isDesktop ? 42 : 24 },
              { autoAlpha: 1, x: 0, y: 0, ease: "power2.out" },
              "compose+=0.28"
            )
            .fromTo(
              ".latest-deck",
              { autoAlpha: 0, y: 36 },
              { autoAlpha: 1, y: 0, duration: 0.3, ease: "power2.out" },
              "compose+=0.66"
            )
            .set(
              ".deck-card",
              {
                autoAlpha: 0,
                y: (index) => index === 0 ? 36 : (isDesktop ? 440 : 350) + index * 24,
                scale: 1,
                zIndex: (index) => 20 + index * 10,
              },
              "compose+=0.84"
            )
            .set(".deck-card .deck-card-content", { autoAlpha: 1 }, "compose+=0.9")
            .set(".deck-card .deck-card-peek", { autoAlpha: 0 }, "compose+=0.9")
            .to(
              ".deck-card:nth-child(1)",
              {
                autoAlpha: 1,
                y: 0,
                duration: 0.46,
                ease: "power2.out",
              },
              "compose+=0.9"
            )
            .to(
              ".deck-card:nth-child(1)",
              {
                y: 0,
                scale: 0.97,
                autoAlpha: 1,
                zIndex: 20,
                duration: 0.78,
              },
              "compose+=1.72"
            )
            .to(
              ".deck-card:nth-child(2)",
              {
                y: stackGap,
                scale: 1,
                autoAlpha: 1,
                zIndex: 30,
                duration: 0.86,
                ease: "power2.inOut",
              },
              "compose+=1.72"
            )
            .to(
              ".deck-card:nth-child(1)",
              {
                y: 0,
                scale: 0.94,
                autoAlpha: 1,
                zIndex: 20,
                duration: 0.76,
              },
              "compose+=2.78"
            )
            .to(
              ".deck-card:nth-child(2)",
              {
                y: stackGap,
                scale: 0.97,
                autoAlpha: 1,
                zIndex: 30,
                duration: 0.76,
              },
              "compose+=2.78"
            )
            .to(
              ".deck-card:nth-child(3)",
              {
                y: stackGap * 2,
                scale: 1,
                autoAlpha: 1,
                zIndex: 40,
                duration: 0.9,
                ease: "power2.inOut",
              },
              "compose+=2.78"
            )
            ;

          window.addEventListener("load", () => ScrollTrigger.refresh());
          window.addEventListener("portfolio:layout-change", () => ScrollTrigger.refresh());

          const projectsSection = document.querySelector(".projects-section");
          if (projectsSection) {
            let refreshFrame = 0;
            const projectsObserver = new ResizeObserver(() => {
              cancelAnimationFrame(refreshFrame);
              refreshFrame = requestAnimationFrame(() => ScrollTrigger.refresh());
            });
            projectsObserver.observe(projectsSection);
            window.addEventListener(
              "pagehide",
              () => {
                cancelAnimationFrame(refreshFrame);
                projectsObserver.disconnect();
              },
              { once: true }
            );
          }
        }
      );
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --ink: #111111;
    --paper: #fbfaf7;
    --soft: #eee8df;
    --muted: #6e6a62;
    --accent: #e84a5f;
    --blue: #2457b8;
    --surface: rgba(255, 255, 255, 0.66);
    --surface-strong: #ffffff;
    --line: rgba(17, 17, 17, 0.14);
    --control-bg: rgba(251, 250, 247, 0.72);
    --control-border: rgba(17, 17, 17, 0.16);
    --control-hover: rgba(17, 17, 17, 0.38);
    --yin-yang-border: rgba(17, 17, 17, 0.34);
    --yin-yang-shadow:
      0 20px 42px rgba(17, 17, 17, 0.18),
      0 5px 12px rgba(17, 17, 17, 0.12),
      0 0 0 1px rgba(255, 255, 255, 0.7);
    --yin-yang-inset: inset 0 1px 2px rgba(255, 255, 255, 0.28);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-width: 320px;
    overflow-x: hidden;
    background: var(--paper);
    color: var(--ink);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    transition:
      background-color 220ms ease,
      color 220ms ease;
  }

  body[data-theme="dark"] {
    color-scheme: dark;
    --ink: #f6f0e8;
    --paper: #10100f;
    --soft: #28231f;
    --muted: #b9afa4;
    --accent: #ff5b72;
    --blue: #6c9cff;
    --surface: rgba(31, 29, 27, 0.72);
    --surface-strong: #25221f;
    --line: rgba(246, 240, 232, 0.16);
    --control-bg: rgba(31, 29, 27, 0.72);
    --control-border: rgba(246, 240, 232, 0.18);
    --control-hover: rgba(246, 240, 232, 0.44);
    --yin-yang-border: rgba(246, 240, 232, 0.34);
    --yin-yang-shadow:
      0 22px 48px rgba(0, 0, 0, 0.62),
      0 6px 14px rgba(0, 0, 0, 0.42),
      0 0 0 1px rgba(246, 240, 232, 0.22),
      0 0 26px rgba(246, 240, 232, 0.08);
    --yin-yang-inset: inset 0 1px 2px rgba(255, 255, 255, 0.22);
  }

  main {
    overflow: hidden;
  }

  .typed-line {
    margin: 0;
    white-space: nowrap;
  }

  .text-type {
    display: inline-block;
    white-space: pre-wrap;
  }

  .text-type__content {
    display: inline;
  }

  .text-type__cursor {
    display: inline-block;
    margin-left: 0.12em;
    color: currentColor;
    opacity: 1;
  }

  .glitch-line {
    position: relative;
    top: -20px;
    width: max-content;
    margin-inline: auto;
    min-height: 1.2em;
    color: var(--muted);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: clamp(1.1rem, 2.4vw, 2rem);
    font-weight: 650;
    will-change: transform, opacity;
  }

  .name-line {
    min-height: 1em;
    font-family: Arial, Helvetica, sans-serif;
    font-size: var(--hero-statement-size);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: 0;
    transform-origin: center center;
  }

  .identity-line {
    position: absolute;
    top: calc(100% - 0.92em);
    left: 0;
    min-height: 1em;
    width: max-content;
    margin: 0;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.28em;
    color: var(--ink);
    font-family: Arial, Helvetica, sans-serif;
    font-size: var(--hero-statement-size);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: 0;
    opacity: 0;
    text-align: left;
    white-space: nowrap;
    will-change: opacity, transform;
  }

  .identity-word {
    position: relative;
    min-width: 0;
    margin-left: 0;
    display: inline-flex;
    align-items: baseline;
    justify-content: flex-start;
    color: #f25a1d;
    font-weight: 900;
    text-align: left;
    vertical-align: baseline;
  }

  .identity-prefix {
    flex: 0 0 auto;
  }

  .identity-word-typed {
    position: relative;
    display: inline-block;
    min-height: 1em;
  }

  .identity-word-typed::after {
    position: absolute;
    right: 0;
    bottom: -0.16em;
    left: 0;
    height: 0.08em;
    min-height: 3px;
    content: "";
    background: #f25a1d;
  }

  .identity-word__cursor {
    position: relative;
    bottom: 0.02em;
    flex: 0 0 auto;
    margin-left: 0.08em;
  }

  .hello-mark {
    grid-column: 1;
    grid-row: 1;
    position: relative;
    top: clamp(24px, 3svh, 38px);
    align-self: center;
    justify-self: center;
    width: min(100%, var(--compose-width));
    height: auto;
    aspect-ratio: 2 / 3;
    max-width: 520px;
    max-height: var(--compose-height);
    display: block;
    border: 0;
    background: #fbfaf7;
    box-shadow: none;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transform-origin: center center;
    will-change: opacity, transform;
  }

  .hello-mark img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    transform: none;
  }

  .name-letter {
    position: relative;
    display: inline-grid;
    place-items: center;
    min-width: 0.74em;
    min-height: 1.08em;
    margin-inline: -0.025em;
    border-radius: 2px;
    padding: 0.01em 0.1em 0.08em;
    transform-origin: 50% 62%;
    transition:
      background-color 120ms ease,
      color 120ms ease,
      clip-path 120ms ease,
      transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1),
      text-shadow 120ms ease;
    cursor: pointer;
    isolation: isolate;
    will-change: transform, color, background-color, clip-path;
  }

  .name-letter::before,
  .name-letter::after {
    position: absolute;
    inset: -0.16em -0.12em -0.12em;
    content: "";
    opacity: 0;
    pointer-events: none;
  }

  .name-letter::before {
    z-index: -2;
    background:
      radial-gradient(circle at 18% 22%, rgba(17, 17, 17, 0.2) 0 1px, transparent 1.4px),
      radial-gradient(circle at 78% 62%, rgba(255, 255, 255, 0.4) 0 1px, transparent 1.5px),
      var(--scrap-paper, transparent);
    background-size: 0.13em 0.13em, 0.19em 0.17em, auto;
    box-shadow:
      -0.02em -0.015em 0 rgba(255, 255, 255, 0.8),
      0.035em 0.045em 0 rgba(17, 17, 17, 0.18),
      0 0.13em 0.26em rgba(17, 17, 17, 0.2);
    clip-path: var(--scrap-clip, inset(0));
  }

  .name-letter::after {
    z-index: -1;
    mix-blend-mode: multiply;
    background:
      repeating-linear-gradient(0deg, rgba(17, 17, 17, 0.08) 0 1px, transparent 1px 0.12em),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.16) 0 1px, transparent 1px 0.16em);
    clip-path: var(--scrap-clip, inset(0));
  }

  .name-letter:hover,
  .name-letter:focus-visible {
    background-color: var(--scrap-paper);
    clip-path: var(--scrap-clip, inset(0));
    box-shadow:
      -0.02em -0.015em 0 rgba(255, 255, 255, 0.8),
      0.035em 0.045em 0 rgba(17, 17, 17, 0.18),
      0 0.13em 0.26em rgba(17, 17, 17, 0.2);
    color: var(--scrap-ink);
    font-family: var(--scrap-font);
    font-style: normal;
    font-weight: 900;
    transform: translateY(var(--scrap-y, -8px)) rotate(var(--scrap-tilt, -4deg))
      scale(var(--scrap-scale, 1.14));
    text-shadow:
      0.026em 0.026em 0 var(--scrap-stroke),
      -0.01em 0.015em 0 rgba(255, 255, 255, 0.35);
    -webkit-text-stroke: 0.01em var(--scrap-stroke);
  }

  .name-letter:hover::before,
  .name-letter:focus-visible::before {
    opacity: 1;
  }

  .name-letter:hover::after,
  .name-letter:focus-visible::after {
    opacity: 0.85;
  }

  .name-letter[data-texture="ruled"]::after {
    background:
      repeating-linear-gradient(0deg, transparent 0 0.16em, rgba(204, 116, 45, 0.22) 0.17em 0.18em),
      repeating-linear-gradient(18deg, rgba(218, 179, 79, 0.2) 0 1px, transparent 1px 0.16em);
  }

  .name-letter[data-texture="yellow-print"]::after,
  .name-letter[data-texture="yellow-clean"]::after {
    background:
      repeating-linear-gradient(14deg, rgba(132, 94, 0, 0.16) 0 1px, transparent 1px 0.16em),
      radial-gradient(circle at 28% 30%, rgba(132, 94, 0, 0.18) 0 1px, transparent 1.4px);
    background-size: auto, 0.15em 0.15em;
  }

  .name-letter[data-texture="cream-paper"]::after,
  .name-letter[data-texture="orange-paper"]::after,
  .name-letter[data-texture="purple-paper"]::after {
    background:
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.2) 0 1px, transparent 1px 0.14em),
      radial-gradient(circle at 20% 70%, rgba(17, 17, 17, 0.1) 0 1px, transparent 1.3px);
    background-size: auto, 0.19em 0.17em;
  }

  .name-letter[data-texture="kraft"]::after {
    background:
      repeating-linear-gradient(28deg, rgba(255, 255, 255, 0.12) 0 1px, transparent 1px 0.14em),
      repeating-linear-gradient(110deg, rgba(17, 17, 17, 0.1) 0 1px, transparent 1px 0.19em);
  }

  .name-letter[data-texture="denim"]::after,
  .name-letter[data-texture="dark-print"]::after {
    background:
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.22) 0 1px, transparent 1px 0.11em),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.12) 0 1px, transparent 1px 0.13em),
      radial-gradient(circle at 72% 38%, rgba(17, 17, 17, 0.18) 0 1px, transparent 1.4px);
  }

  .name-letter[data-texture="outline"]::after {
    background:
      radial-gradient(circle at 20% 20%, rgba(17, 17, 17, 0.2) 0 1px, transparent 1.4px),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.35) 0 1px, transparent 1px 0.2em);
  }

  .name-letter[data-texture="grid"]::after {
    background:
      repeating-linear-gradient(0deg, rgba(17, 17, 17, 0.14) 0 1px, transparent 1px 0.18em),
      repeating-linear-gradient(90deg, rgba(17, 17, 17, 0.12) 0 1px, transparent 1px 0.18em);
  }

  .name-letter[data-texture="grain"]::after,
  .name-letter[data-texture="speckle"]::after {
    background:
      radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.4) 0 1px, transparent 1.5px),
      radial-gradient(circle at 70% 34%, rgba(17, 17, 17, 0.32) 0 1px, transparent 1.4px),
      radial-gradient(circle at 46% 78%, rgba(17, 17, 17, 0.22) 0 1px, transparent 1.2px);
    background-size: 0.18em 0.18em, 0.14em 0.17em, 0.21em 0.19em;
  }

  .name-letter[data-texture="crumple"]::after,
  .name-letter[data-texture="fibers"]::after,
  .name-letter[data-texture="newsprint"]::after {
    background:
      repeating-linear-gradient(25deg, rgba(255, 255, 255, 0.2) 0 1px, transparent 1px 0.18em),
      repeating-linear-gradient(115deg, rgba(17, 17, 17, 0.08) 0 1px, transparent 1px 0.22em),
      radial-gradient(circle at 25% 65%, rgba(17, 17, 17, 0.16) 0 1px, transparent 1.4px);
  }

  .scroll-note {
    position: absolute;
    top: calc(100% + 92px);
    left: 50%;
    display: block;
    margin: 0;
    padding: 0;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 750;
    text-transform: uppercase;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .opening-stage {
    min-height: 400vh;
    background: var(--paper);
    transition: background-color 220ms ease;
  }

  .opening-pin {
    --compose-height: clamp(560px, 70svh, 720px);
    --compose-width: clamp(373px, 46.67svh, 480px);
    --hero-statement-size: clamp(3.25rem, 6.5vw, 6.5rem);
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(240px, 0.8fr) minmax(320px, 1fr);
    align-items: center;
    gap: clamp(32px, 8vw, 120px);
    padding: clamp(24px, 5vw, 72px);
  }

  .name-lockup {
    position: absolute;
    top: 42px;
    left: 28px;
    width: max-content;
    max-width: min(92vw, 980px);
    text-align: center;
    transform-origin: left center;
    will-change: transform;
    z-index: 2;
  }

  .social-links {
    position: absolute;
    top: 28px;
    right: 28px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 14px;
    opacity: 0;
    z-index: 3;
    will-change: opacity, transform;
  }

  .social-icon-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .social-links a {
    width: 38px;
    aspect-ratio: 1;
    display: inline-grid;
    place-items: center;
    border: 1px solid var(--control-border);
    border-radius: 50%;
    background: var(--control-bg);
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 850;
    line-height: 1;
    text-decoration: none;
    backdrop-filter: blur(12px);
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .theme-toggle {
    position: relative;
    width: 58px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    border: 0;
    background: transparent;
    padding: 0;
    cursor: pointer;
  }

  .theme-toggle-track {
    position: relative;
    width: 58px;
    height: 32px;
    display: block;
    border: 1px solid var(--control-border);
    border-radius: 999px;
    background: rgba(17, 17, 17, 0.14);
    box-shadow: inset 0 1px 3px rgba(17, 17, 17, 0.16);
    backdrop-filter: blur(12px);
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 160ms ease;
  }

  .theme-toggle-thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 24px;
    aspect-ratio: 1;
    display: block;
    border-radius: 50%;
    background: #ffffff;
    box-shadow:
      0 1px 2px rgba(17, 17, 17, 0.18),
      0 4px 10px rgba(17, 17, 17, 0.16);
    transition:
      transform 190ms cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 180ms ease;
  }

  .social-links a:hover,
  .social-links a:focus-visible,
  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    border-color: var(--control-hover);
    background: var(--surface-strong);
    transform: translateY(-2px);
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    background: transparent;
  }

  .theme-toggle:hover .theme-toggle-track,
  .theme-toggle:focus-visible .theme-toggle-track {
    border-color: var(--control-hover);
    transform: translateY(-2px);
  }

  body[data-theme="dark"] .theme-toggle-track {
    border-color: rgba(242, 90, 29, 0.5);
    background: #f25a1d;
    box-shadow: inset 0 1px 3px rgba(17, 17, 17, 0.22);
  }

  body[data-theme="dark"] .theme-toggle-thumb {
    transform: translateX(26px);
  }

  .social-links svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .section-kicker {
    margin: 0 0 10px;
    color: var(--accent);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.88rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .name-lockup strong {
    display: block;
    max-width: 560px;
    font-size: clamp(3rem, 8vw, 7.5rem);
    line-height: 0.88;
    letter-spacing: 0;
  }

  .latest-content {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    top: clamp(24px, 3svh, 38px);
    align-self: center;
    justify-self: start;
    width: 100%;
    height: var(--compose-height);
    min-width: 0;
    max-width: 1040px;
    display: flex;
    flex-direction: column;
    padding-top: 0;
    opacity: 0;
    z-index: 1;
  }

  h2 {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(1.775rem, calc(6vw - 0.625rem), 5.175rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: 0;
  }

  #latest-title {
    position: relative;
    top: 0;
    flex: 0 0 auto;
    z-index: 40;
  }

  .latest-deck {
    --deck-stack-gap: 22px;
    --deck-card-height: clamp(236px, 22vw, 300px);
    position: relative;
    z-index: 1;
    width: min(100%, 980px);
    height: calc(var(--deck-card-height) + var(--deck-stack-gap) + var(--deck-stack-gap));
    min-height: 0;
    flex: 0 0 auto;
    margin-top: auto;
    margin-inline: auto 0;
    opacity: 0;
    perspective: 900px;
    min-width: 0;
  }

  @media (min-width: 761px) {
    /* Match the copy and stack to the visible subject inside the GIF canvas. */
    #latest-title {
      top: clamp(54px, 7svh, 72px);
    }

    .latest-deck {
      margin-bottom: clamp(120px, 15svh, 150px);
    }
  }

  .deck-card {
    position: absolute;
    right: 0;
    left: 0;
    height: var(--deck-card-height);
    display: block;
    border: 0;
    border-radius: 28px;
    padding: clamp(24px, 3.2vw, 40px);
    background: var(--deck-bg);
    color: var(--deck-ink);
    box-shadow:
      0 18px 42px rgba(17, 17, 17, 0.12),
      0 1px 0 rgba(255, 255, 255, 0.18) inset;
    opacity: 0;
    transform-origin: center top;
    will-change: transform, opacity, border-radius;
    box-sizing: border-box;
    max-width: 100%;
    min-width: 0;
  }

  .deck-card:nth-child(1) {
    --deck-bg: #f25a1d;
    --deck-ink: #fff4ee;
  }

  .deck-card:nth-child(2) {
    --deck-bg: #cf2f72;
    --deck-ink: #fff4fb;
  }

  .deck-card:nth-child(3) {
    --deck-bg: #ffe1d6;
    --deck-ink: #151515;
  }

  .deck-card:nth-child(2) {
    top: 0;
  }

  .deck-card:nth-child(3) {
    top: 0;
  }

  .deck-card-heading {
    display: flex;
    align-items: flex-start;
    gap: clamp(14px, 2vw, 24px);
    min-width: 0;
  }

  .deck-card-content {
    height: 100%;
    display: flex;
    align-items: center;
    will-change: opacity;
  }

  .deck-card-peek {
    position: absolute;
    right: clamp(24px, 3.2vw, 40px);
    bottom: 18px;
    left: clamp(24px, 3.2vw, 40px);
    display: flex;
    align-items: baseline;
    gap: 12px;
    opacity: 0;
    will-change: opacity;
  }

  .deck-card-peek p,
  .deck-card-peek h3 {
    margin: 0;
  }

  .deck-card h3 {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .deck-card p {
    margin: 0;
    color: currentColor;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.82rem;
    font-weight: 850;
    letter-spacing: 0;
  }

  .deck-card h3 {
    margin: 0;
    color: currentColor;
    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(2.1rem, 3.6vw, 3.75rem);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .deck-card .company-link {
    gap: 0.08em;
    color: #172b75;
  }

  .deck-card .company-link:hover {
    color: #07184d;
  }

  .deck-card .company-link::after {
    content: none;
  }

  body[data-theme="dark"] .deck-card {
    box-shadow:
      0 22px 48px rgba(0, 0, 0, 0.32),
      0 1px 0 rgba(255, 255, 255, 0.12) inset;
  }

  .experiences-section {
    min-height: 82svh;
    display: grid;
    place-items: start center;
    padding: clamp(28px, 5vw, 72px);
    padding-top: clamp(34px, 6vh, 74px);
    background: var(--paper);
    color: var(--ink);
    overflow: hidden;
  }

  .experiences-inner {
    width: min(1180px, 100%);
  }

  :global(.experiences-title) {
    margin: 0;
    display: inline-flex;
    font-size: clamp(5.4rem, 16.5vw, 15rem);
    font-family: "Roboto Flex Portfolio", Arial, Helvetica, sans-serif;
    font-weight: 620;
    line-height: 0.82;
    letter-spacing: 0;
    text-align: left;
    opacity: 0;
    cursor: default;
    user-select: none;
    will-change: transform, opacity;
  }

:global(.experiences-title .text-pressure-letter) {
  display: inline-block;
  flex: 0 0 auto;
  text-align: center;
  color: var(--ink);
  font-variation-settings: "opsz" 144, "wght" 620, "wdth" 86, "slnt" 0;
  will-change: font-variation-settings;
}

  .experiences-subtitle {
    width: min(760px, 100%);
    margin: clamp(24px, 3vw, 40px) 0 0 auto;
    color: var(--muted);
    font-size: clamp(1.1rem, 2.4vw, 2rem);
    line-height: 1.25;
    text-align: right;
    opacity: 0;
    will-change: transform, opacity;
  }

  .experience-island {
    position: relative;
    width: min(400px, 100%);
    min-height: 82px;
    max-width: 100%;
    margin: clamp(44px, 7vw, 82px) auto 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    padding: 0;
    border: 1px solid var(--yin-yang-border);
    border-radius: 999px;
    background: transparent;
    box-shadow: var(--yin-yang-shadow);
    opacity: 0;
    will-change: transform, opacity;
    isolation: isolate;
  }

  .yin-yang-surface {
    --curve-size: 41px;
    position: absolute;
    inset: 0;
    border-radius: 999px;
    overflow: hidden;
    background: #171717;
    box-shadow: var(--yin-yang-inset);
  }

  .yin-yang-white-field {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 58%;
    border-radius: 0 999px 999px 0;
    background: #fffdf8;
    transition: left 620ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: left;
  }

  .yin-yang-white-field::before,
  .yin-yang-white-field::after {
    content: "";
